# ══════════════════════════════════════════════════════════
#  节点上 /data/cortex/.env 的模板
#
#  ⚠️ **这个文件分两半，落到节点上是两个文件。**
#
#    /data/cortex/.env           ← 下面「A. 非敏感」那半。**由 ansible 渲染**，
#                                   每次部署覆盖。手改会被下一次部署冲掉。
#    /data/cortex/.env.secrets   ← 下面「B. 敏感」那半。**装机时人工写一次**，
#                                   chmod 600，永不进 CI、永不进 git。
#                                   ansible 只检查它在不在，从不写它。
#
#  compose 两份都读：
#      docker compose --env-file .env --env-file .env.secrets up -d
#  （ansible 那边是 `docker_compose_v2` 的 `env_files: [.env, .env.secrets]`）
#
#  ⚠️ 一旦显式给了 `--env-file`，compose 就**不再自动读 .env** —— 两个都得列。
#
#  为什么这么拆：ansible 用的是全权 SSH 密钥，那把钥匙在 GitHub Secrets 里。
#  secrets 留在节点上，至少它们不会在 GitHub 那边**再存一份**（那是一个独立的
#  窃取目标：一个恶意 action 能把所有 secret 一次 dump 出来）。
#
#  ── 这份模板由一道闸看着 ──────────────────────────────────
#
#  `scripts/check-compose-env.sh`（进 `just ci`）会检查：
#  **compose 里没有默认值的 ${VAR} 必须在这里有一行。**
#  有默认值的豁免 —— compose 自己兜得住，列出来只是为了让人知道能调。
#
#  这道闸是 2026-08-23 加的，因为这份模板在 Cormex 拆分之后漂了半个月没人
#  发现：拿它装新机器，CORTEX_PG_PASSWORD 与 S3_DOMAIN 都是缺的（两个都没有
#  默认值，直接起不来），而模板里还留着 12 个记忆服务时代的变量。
# ══════════════════════════════════════════════════════════


# ══════════════════════════════════════════════════════════
#  A. 非敏感 —— 这半进 /data/cortex/.env，由 ansible 渲染
# ══════════════════════════════════════════════════════════

# ── 版本 ──────────────────────────────────────────────────
# **由 ansible 渲染**（`-e version=X.Y.Z`）。手动初始化时填第一个要上线的版本。
# 永远是具体版本，**绝不用 latest** —— 会漂移的 tag 会让「线上跑的到底是
# 哪一版」变成查不清的问题。
CORTEX_VERSION=v0.1.18

# 镜像仓库。默认阿里云 ACR（节点在国内，第一方，不经第三方镜像站）。
# 异地副本切过去：CORTEX_REGISTRY=willdockerhub
# CORTEX_REGISTRY=registry.cn-shenzhen.aliyuncs.com/willspace

# ── 域名 ──────────────────────────────────────────────────
# ★ **没有默认值，必填**；而且必须已经 A 记录指向本机，否则 Let's Encrypt 的
#   HTTP-01 挑战过不了，证书签不下来。验证：dig +short cortex.cloudcele.com
DOMAIN=cortex.cloudcele.com
#
# ⚠️ `s3.cortex.cloudcele.com` 的 A 记录**也要有**，但 `S3_DOMAIN` 这个变量
#    不在这一栈里 —— rustfs 跟着记忆服务去了 /data/cormex，那条 traefik 路由
#    由那一栈声明。这边只是通过 S3_ENDPOINT 从内网连过去。
#    （deploy/docker-compose.yml 顶部那句注释还写着两个域名，属实；
#     但只有 DOMAIN 是这份 .env 的事。）

# 对外可见的地址。分享链接（/s/<token>/image.png）用它拼绝对 URL。
# 留空则回落到请求头 —— 经 traefik 时通常是对的，但反代少一个头就会拼出
# http://127.0.0.1/s/... 那种复制出去打不开的链接，而症状离原因很远。
CORTEX_PUBLIC_URL=https://cortex.cloudcele.com

# ── 自己的 Postgres（会话库）───────────────────────────────
# ⚠️ 与记忆服务那个 postgres 是**两套**。它在 /data/cormex 那一栈，带 pgvector；
#    这一套只装会话：消息、附件、项目、同步流水。
CORTEX_PG_USER=cortex
CORTEX_PG_DB=cortex

# ── 对象存储 ──────────────────────────────────────────────
S3_BUCKET=cortex-blobs
S3_REGION=us-east-1
# 容器内部地址，走 compose 网络。对外那条是 S3_DOMAIN 经 traefik
S3_ENDPOINT=http://cortex-rustfs:9000

# ── 记忆服务 ──────────────────────────────────────────────
# 它是**另一个仓库、另一条版本线**（github.com/weironz/cormex），部署在这台
# 机器的 /data/cormex 那一栈里。这里只需要知道打哪儿。
CORTEX_MEMORY_URL=http://cormex:8080

# ── LLM ───────────────────────────────────────────────────
CORTEX_LLM_PROVIDER=deepseek
# 留空则用供应商默认型号
# CORTEX_LLM_MODEL=
# CORTEX_LLM_CHEAP_MODEL=

# 计价与配额。留空 = 不显示花费、不限额
# CORTEX_MODEL_PRICES=
# CORTEX_PRICE_CURRENCY=CNY
# CORTEX_USD_RATE=7.2
# CORTEX_QUOTA_TOKENS_PER_MONTH=

# ── 注册 ──────────────────────────────────────────────────
# 空 = 关闭注册（只有管理员账号）。开放注册填 1
# CORTEX_OPEN_REGISTRATION=

# ── 云沙箱（Web 端在容器里跑文件与命令）───────────────────
#
# **默认关。开它要改下面三项，缺一不可。**
# 三项都对了才会有沙箱；漏了哪一项 agentd 会在启动日志里说清原因然后关掉
# 沙箱继续跑 —— 不是启动失败，也不是「看着开了点下去才发现」。
#
# ⚠️ 第三项是把这台机器的 root 交给 agentd：能访问 docker.sock 就能起一个
#    挂着宿主 / 的特权容器。这台机器上还跑着 mica / neostor / headscale /
#    rustdesk，爆炸半径会从「一个部署」变成「整台机器 + 别人四个服务」。
#    论证的另一半是容器规格全部写死在 DockerRunner 里，调用方说不出第二个挂载。
#
# CORTEX_SANDBOX_ENABLED=1
# COMPOSE_PROFILES=sandbox
# CORTEX_DOCKER_SOCK=/var/run/docker.sock
# CORTEX_DOCKER_GID=126        # ← **必须自己查**：stat -c %g /var/run/docker.sock
#
# 最后那个 gid 因发行版而异（这台 126、Ubuntu 常见 999、Docker Desktop 是 0）。
# 写错不会静默：agentd 起来就是 `client error (Connect)` 然后 restart 循环 ——
# 而那条错误读起来像「docker 没起来」，实际是「进程不在那个组里」。
#
# 每个沙箱吃 512 MiB。这台是 2C/3.5G 且已跑着别的东西，大约能同时开 1~2 个。
#
# 沙箱回调与中继地址（容器里的 agent 打回来用），一般不用改：
# CORTEX_SANDBOX_CALLBACK=http://agentd:8081
# CORTEX_SANDBOX_RELAY=
# 整条镜像引用可以覆盖，默认跟着 CORTEX_VERSION 走：
# CORTEX_SANDBOX_IMAGE=

# 沙箱出网。默认 `*` = 整张**公网**。不是「不限制」：目标解析到内网地址时
# 代理仍会拒（代理与 postgres/rustfs 同在一张网上，不判 IP 就等于给沙箱一条
# 通往数据库的路）。
#
# 要让沙箱够到某个**内网**地址，把它**指名道姓**写进来 —— 通配不算：
# CORTEX_EGRESS_ALLOW=*,my-internal-api.lan:8080
#
# 想收紧回「只能装依赖」：
# CORTEX_EGRESS_ALLOW=pypi.org,*.pypi.org,files.pythonhosted.org,registry.npmjs.org
# CORTEX_EGRESS_DENY=

# ── 备份 ──────────────────────────────────────────────────
# ★ 指到与数据盘**不同**的物理盘。和数据同盘的备份防得住误删，
#   防不住盘坏，而盘坏才是备份存在的理由
CORTEX_BACKUP_DIR=/data/cortex/backup

# ── 异地备份的节奏与保留（凭据在 B 节）─────────────────────
# 备份容器（compose 的 `backup` profile）读这几个。开不开这个容器由
# ansible 的 cortex_backup_enabled 决定，凭据见下面 B 节的「异地备份」。
BACKUP_HOUR=3
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6
# 周几跑一次 rustic check（1=周一 … 7=周日）。对象存储的静默损坏只能靠
# 问才发现 —— 一份坏掉的快照在 snapshots 列表里长得和好的一模一样
CORTEX_BACKUP_CHECK_DOW=7

# ── 资源上限 ──────────────────────────────────────────────
# 这台机器上还跑着 mica / neostor / headscale / rustdesk，任何一个容器
# 不封顶都能把别人的服务一起拖垮。cpus 不该超过节点核数（这台 2 核）。
AGENTD_CPU_LIMIT=1.0
AGENTD_MEM_LIMIT=512m
CORTEX_PG_CPU_LIMIT=0.5
CORTEX_PG_MEM_LIMIT=384m
CORTEX_EGRESS_CPU_LIMIT=0.5
CORTEX_EGRESS_MEM_LIMIT=128m

# ── 日志 ──────────────────────────────────────────────────
AGENTD_LOG=cortex_agentd=info,warn
CORTEX_EGRESS_LOG=cortex_egress_proxy=info,warn


# ══════════════════════════════════════════════════════════
#  B. 敏感 —— 这半进 /data/cortex/.env.secrets，**人工写一次**
#
#  chmod 600、属主 root。ansible 只 stat 它、不存在就当场失败，
#  **从不写它**。换机器时这是唯一需要人手动做的一步。
#
#  ⚠️ 一行都不许出现在 git、GitHub Secrets、CI 日志里。
# ══════════════════════════════════════════════════════════

# ── 会话库口令 ────────────────────────────────────────────
# ★ compose 里是 ${CORTEX_PG_PASSWORD:?}，**没有默认值，缺了直接拒绝启动**。
#   这个库不发布任何端口，只在 compose 网络里可达，但弱口令 + 将来某次
#   「临时开一下端口排查」就是一次事故。用 `openssl rand -hex 32`
CORTEX_PG_PASSWORD=

# ── 对象存储 ──────────────────────────────────────────────
RUSTFS_ACCESS_KEY=cortexadmin
# ★ 这一个是**互联网可达**的：s3.cortex.cloudcele.com 经 traefik 直接对外。
#   `openssl rand -hex 32`
RUSTFS_SECRET_KEY=

# ── 异地备份：rustic（Postgres）+ rclone（RustFS）→ 阿里云 OSS ──
#
# 完整说明与恢复步骤见 docs/backup.md。**留空 = 不起备份容器**，
# 只有本机备份 —— 而本机备份防得住误删，防不住整机丢失。
#
# 桶名 / 端点也放在这一节而不是 A 节：它们与下面那把 key 是**同一次操作**
# 产生的（建桶 → 建 RAM 子账号 → 授权那个桶）。拆到两个文件里配，
# 等于让人做一件事要开两处，而漏掉一处的症状是备份容器起不来。
#
# ⚠️ 这把 AccessKey 必须与上面 RUSTFS_* 那把**不是同一把**：用同一把的话，
#    一次泄露同时拿到主存储与备份，而备份存在的全部意义正是
#    「主存储出事时它还在」。
#
# ⚠️ 桶上**必须开版本控制**（这台已开）。一次跑飞的 prune、一把被偷的 key
#    都能把历史擦干净 —— 只增不减的镜像挡不住「有人主动删」。
#
# 关于「只授一个桶的 RAM 子账号」与「异地建桶」：**这两条 2026-08-25 明知
# 代价地决定不做**，理由见 docs/backup.md「两个明知代价、仍然这么定的取舍」。
# 别当成疏漏补上 —— 要改先读那一节。
OSS_BUCKET=cortex-backup-cloudcele
OSS_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
OSS_REGION=oss-cn-shenzhen
# 对象 key 前缀。与别的仓库共用一个桶时给自己一个新前缀，否则
# rustic init 会说「config file already exists」
OSS_ROOT=cortex
OSS_ACCESS_KEY_ID=
OSS_SECRET_ACCESS_KEY=
# ★★ **丢了它整个备份仓库就再也打不开了。存一份在这台机器之外。**
#
# ⚠️ 名字是 `CORTEX_BACKUP_PASSWORD`。这台机器上 mica 那套用的是
# `RUSTIC_BACKUP_PASSWORD` —— **两个不同的仓库、两个不同的口令**，
# 从一份配置抄到另一份时别把名字或值带过去：抄错名字的症状是容器起来就
# 报缺变量（响的）；抄错值的症状是**在另一个仓库上初始化出第二份历史**
# （不响的）。
CORTEX_BACKUP_PASSWORD=

# ── 死人开关（可选）───────────────────────────────────────
# 备份成功 ping 它，失败 ping <URL>/fail。指向 healthchecks.io 之类。
# 它覆盖的是**「压根没跑」** —— 那一类不产生任何退出码，也就不会有任何
# 告警：容器死了、循环卡住了，你手上每一个信号都还是绿的。
# 是一个 capability URL（拿到就能替你打点），所以放在这一节。
HEALTHCHECK_URL=

# ── 认证 ──────────────────────────────────────────────────
# 认证形态。`token` = 预共享 token（自托管常态）；留空走账号体系
CORTEX_AUTH=token

# 预共享 token 的**摘要**。生成：
#     docker run --rm registry.cn-shenzhen.aliyuncs.com/willspace/cortex-agentd:v0.1.18 \
#         --generate-token
# 输出两行：摘要写这里，明文给客户端。
# 明文不要也留在这台机器上 —— 服务端只需要摘要就能验证，
# 两者放在一起等于把摘要这层保护白白丢掉
CORTEX_AUTH_TOKEN_SHA256=

# 签会话令牌用的密钥。`openssl rand -hex 32`。
# ⚠️ 换掉它 = 所有人当场登出（已签发的令牌全部失效）
CORTEX_SECRET_KEY=

# 第一个管理员账号。只在库是空的时候生效一次；建好之后改这两行没有任何作用
CORTEX_ADMIN_USERNAME=
CORTEX_ADMIN_PASSWORD=

# ── 联网检索（可选）─────────────────────────────────────
# 配了才有 `web_search` 工具。没配的话它整个不进工具目录 ——
# 摆一个必然失败的工具比没有它更糟。
# Tavily 或任何兼容它 /search 协议的服务；自建的用 CORTEX_SEARCH_BASE_URL 指过去
# CORTEX_SEARCH_API_KEY=
# CORTEX_SEARCH_BASE_URL=

# ── LLM key ───────────────────────────────────────────────
# 按 CORTEX_LLM_PROVIDER 填对应那个。缺了模型那条路整个不通
DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
