# ══════════════════════════════════════════════════════════
#  节点上 /data/cortex/.env 的模板
#
#  复制成 .env 后逐项填。**这个文件本身不含任何真实凭据，
#  填好的那份 .env 绝不能进 git。**
#
#  部署脚本（/usr/local/sbin/cortex-deploy）只改一行：CORTEX_VERSION。
#  别的全部由人维护。
# ══════════════════════════════════════════════════════════

# ── 版本 ──────────────────────────────────────────────────
# 由 cortex-deploy 改写。手动初始化时填第一个要上线的版本。
# 永远是具体版本，**绝不用 latest** —— 会漂移的 tag 会让
# 「线上跑的到底是哪一版」变成查不清的问题
CORTEX_VERSION=v0.1.0

# 镜像仓库。默认阿里云 ACR（节点在国内，第一方，不经第三方镜像站）。
# 异地副本切过去：CORTEX_REGISTRY=willdockerhub
# CORTEX_REGISTRY=registry.cn-shenzhen.aliyuncs.com/willspace

# ── 域名 ──────────────────────────────────────────────────
# ★ 两个都必须已经 A 记录指向本机，否则 Let's Encrypt 的 HTTP-01
#   挑战过不了，证书签不下来。验证：dig +short cortex.cloudcele.com
DOMAIN=cortex.cloudcele.com
S3_DOMAIN=s3.cortex.cloudcele.com

# ── Postgres ──────────────────────────────────────────────
POSTGRES_USER=cortex
POSTGRES_DB=cortex
# 必填。这个库不发布任何端口，只在 compose 网络里可达，
# 但弱口令 + 将来某次「临时开一下端口排查」就是一次事故
POSTGRES_PASSWORD=

# ── 对象存储 ──────────────────────────────────────────────
RUSTFS_ACCESS_KEY=cortexadmin
# ★ 必填，而且这一个是**互联网可达**的：s3.cortex.cloudcele.com 经
#   traefik 直接对外。用 `openssl rand -hex 32` 生成
RUSTFS_SECRET_KEY=
S3_BUCKET=cortex-blobs
S3_REGION=us-east-1

# ── 认证 ──────────────────────────────────────────────────
# ★★ 必填，没有它 cortexd 拒绝启动（刻意的）。
#
# 生成：
#     docker run --rm registry.cn-shenzhen.aliyuncs.com/willspace/cortexd:v0.1.0 \
#         --generate-token
#
# 输出有两行：**摘要**写这里，**明文** CORTEXD_TOKEN 给客户端。
# 明文不要也留在这台机器上 —— 服务端只需要摘要就能验证
CORTEX_AUTH_TOKEN_SHA256=

# 高风险工具确认的超时（秒）。超时按拒绝处理
CORTEX_CONFIRM_TIMEOUT_SECS=180

# ── LLM 供应商 ────────────────────────────────────────────
CORTEX_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# CORTEX_LLM_MODEL=
# CORTEX_LLM_CHEAP_MODEL=

# ── 向量后端 ──────────────────────────────────────────────
# fast = 真实语义模型（首次启动下 ~590 MB，落在 cortex-prod-models 卷）
# hash = 完全不用模型，但那不是语义空间，检索质量明显下降
CORTEX_EMBED_BACKEND=fast
CORTEX_EMBED_MODEL=bge-m3-int8

# ── 备份 ──────────────────────────────────────────────────
# ★ 指到与数据盘**不同**的物理盘。和数据同盘的备份防得住误删，
#   防不住盘坏，而盘坏才是备份存在的理由
CORTEX_BACKUP_DIR=/data/cortex/backup

# ── 资源上限 ──────────────────────────────────────────────
# 这台机器上还跑着 mica / neostor / headscale / rustdesk。
# embedding 推理会吃满能拿到的核，不限住它一次批量回填就能把
# 别人的服务一起拖垮
CORTEXD_CPU_LIMIT=4
CORTEXD_MEM_LIMIT=4g
POSTGRES_MEM_LIMIT=2g

RUST_LOG=cortexd=info,cortex_memory=info,warn
