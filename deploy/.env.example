# ══════════════════════════════════════════════════════════
#  节点上 /data/cortex/.env 的模板
#
#  复制成 .env 后逐项填。**这个文件本身不含任何真实凭据，
#  填好的那份 .env 绝不能进 git。**
#
#  部署脚本（/usr/local/sbin/cortex-deploy）只改一行：CORTEX_VERSION。
#  别的全部由人维护。
# ══════════════════════════════════════════════════════════

# ── 版本 ──────────────────────────────────────────────────
# 由 cortex-deploy 改写。手动初始化时填第一个要上线的版本。
# 永远是具体版本，**绝不用 latest** —— 会漂移的 tag 会让
# 「线上跑的到底是哪一版」变成查不清的问题
CORTEX_VERSION=v0.1.0

# 镜像仓库。默认阿里云 ACR（节点在国内，第一方，不经第三方镜像站）。
# 异地副本切过去：CORTEX_REGISTRY=willdockerhub
# CORTEX_REGISTRY=registry.cn-shenzhen.aliyuncs.com/willspace

# ── 域名 ──────────────────────────────────────────────────
# ★ 两个都必须已经 A 记录指向本机，否则 Let's Encrypt 的 HTTP-01
#   挑战过不了，证书签不下来。验证：dig +short cortex.cloudcele.com
DOMAIN=cortex.cloudcele.com
S3_DOMAIN=s3.cortex.cloudcele.com

# ── Postgres ──────────────────────────────────────────────
POSTGRES_USER=cortex
POSTGRES_DB=cortex
# 必填。这个库不发布任何端口，只在 compose 网络里可达，
# 但弱口令 + 将来某次「临时开一下端口排查」就是一次事故
POSTGRES_PASSWORD=

# ── 对象存储 ──────────────────────────────────────────────
RUSTFS_ACCESS_KEY=cortexadmin
# ★ 必填，而且这一个是**互联网可达**的：s3.cortex.cloudcele.com 经
#   traefik 直接对外。用 `openssl rand -hex 32` 生成
RUSTFS_SECRET_KEY=
S3_BUCKET=cortex-blobs
S3_REGION=us-east-1

# ── 认证 ──────────────────────────────────────────────────
# ★★ 必填，没有它 cortexd 拒绝启动（刻意的）。
#
# 生成：
#     docker run --rm registry.cn-shenzhen.aliyuncs.com/willspace/cortexd:v0.1.0 \
#         --generate-token
#
# 输出有两行：**摘要**写这里，**明文** CORTEXD_TOKEN 给客户端。
# 明文不要也留在这台机器上 —— 服务端只需要摘要就能验证
CORTEX_AUTH_TOKEN_SHA256=

# 高风险工具确认的超时（秒）。超时按拒绝处理
CORTEX_CONFIRM_TIMEOUT_SECS=180

# ── LLM 供应商 ────────────────────────────────────────────
CORTEX_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# CORTEX_LLM_MODEL=
# CORTEX_LLM_CHEAP_MODEL=

# ── 向量后端 ──────────────────────────────────────────────
#
# **这四项必须填**，没有能用的默认值。cortexd 只发一个 HTTP POST 到
# endpoint，对面是云还是自建容器它不关心。
#
# ★ 模型必须是 **1024 维** —— schema 写死 VECTOR(1024)。
#   OpenAI 的 text-embedding-3-small 是 1536、large 是 3072，接上去会被
#   cortexd 在第一次响应就拒掉（错误信息里写了怎么办）。
#
# 填完部署，先看 `/health` 的 `embedding.model`，应该是 `api:<模型名>`。
CORTEX_EMBED_BACKEND=api
CORTEX_EMBED_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
CORTEX_EMBED_MODEL=text-embedding-v4
CORTEX_EMBED_API_KEY=

# 自建（不出网）就改成起 TEI 容器，那时 endpoint 走 compose 服务名：
#   COMPOSE_PROFILES=embed
#   CORTEX_EMBED_ENDPOINT=http://embeddings/v1/embeddings
#   CORTEX_EMBED_MODEL=bge-m3          # ← TEI 用这个名字，不是 bge-m3-int8
# ⚠️ 它常驻 2.5–3 GB，**这台 2C/3.5G 的机器跑不动**。
#
# `fast`（进程内 ONNX）2026-08-13 起**不在官方镜像里**了：它常驻 1.03 GiB，
# 一个选择就把整机能跑的沙箱数压到 1 个。填了会在启动时直接报错退出。

# ── 云沙箱（Web 端在容器里跑文件与命令）───────────────────
#
# **默认关。开它要改下面三项，缺一不可。**
# 三项都对了才会有沙箱；漏了哪一项 cortexd 会在启动日志里说清原因
# 然后关掉沙箱继续跑 —— 不是启动失败，也不是「看着开了点下去才发现」。
#
# ⚠️ 第三项是把这台机器的 root 交给 cortexd：能访问 docker.sock 就能起一个
#    挂着宿主 / 的特权容器。这台机器上还跑着 mica / neostor / headscale /
#    rustdesk，爆炸半径会从「一个记忆库」变成「整台机器 + 别人四个服务」。
#    而 cortexd 正是直接处理模型输出的那个进程。想清楚再开。
#
# CORTEX_SANDBOX_ENABLED=1
# COMPOSE_PROFILES=sandbox
# CORTEX_DOCKER_SOCK=/var/run/docker.sock
# CORTEX_DOCKER_GID=126        # ← **必须自己查**：stat -c %g /var/run/docker.sock
#
# 最后那个 gid 因发行版而异（这台 126、Ubuntu 常见 999、Docker Desktop 是 0）。
# 写错不会静默：cortexd 启动时真的握一次手，报「docker daemon 握不上手」
# 并关掉云沙箱，其余功能照常。
#
# 每个沙箱吃 512 MiB。这台是 2C/3.5G 且已跑着别的东西，
# cortexd 降到 768m 之后大约还能同时开 1~2 个 —— 不是「随便开」。
#
# 出网默认全拒，清单在 docker-compose.yml 的 egress 段（装依赖 + 拉代码）。
# 加东西就在这里覆盖整份清单（不是追加）：
# CORTEX_EGRESS_ALLOW=pypi.org,*.pypi.org,files.pythonhosted.org,你要加的域名

# ── 备份 ──────────────────────────────────────────────────
# ★ 指到与数据盘**不同**的物理盘。和数据同盘的备份防得住误删，
#   防不住盘坏，而盘坏才是备份存在的理由
CORTEX_BACKUP_DIR=/data/cortex/backup

# ── 资源上限 ──────────────────────────────────────────────
# 这台机器上还跑着 mica / neostor / headscale / rustdesk，任何一个容器
# 不封顶都能把别人的服务一起拖垮。
#
# embedding 挪出进程之后 cortexd 常驻从 1.03 GiB 降到 ~120 MiB，
# 所以上限跟着从 4C/4g 降下来 —— 留着 4g 不会更安全，只会让真正的泄漏
# 拖到把整台机器压垮才被看见。cpus 也不该超过节点核数（这台 2 核）。
CORTEXD_CPU_LIMIT=1.5
CORTEXD_MEM_LIMIT=768m
POSTGRES_MEM_LIMIT=2g

RUST_LOG=cortexd=info,cortex_memory=info,warn
