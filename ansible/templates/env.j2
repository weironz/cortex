{#
  ══════════════════════════════════════════════════════════
   渲染成节点的 /data/cortex/.env —— **只有非敏感的那一半**。

   敏感项在 /data/cortex/.env.secrets，人工写一次，ansible 从不碰它。
   compose 两份都读：env_files: [.env, .env.secrets]

   ⚠️ 这份模板与 `deploy/.env.example` 的 A 节是一一对应的，
   `scripts/check-compose-env.sh` 有一条闸盯着它们别漂。加变量要改两处：
   这里（值）与 .env.example（文档）。
  ══════════════════════════════════════════════════════════
#}
# 这个文件由 ansible 渲染，**手改会被下一次部署覆盖**。
# 要改值请改 ansible/group_vars/cortex_nodes.yml。
# 凭据不在这里 —— 见同目录的 .env.secrets。
#
# 渲染于 {{ ansible_date_time.iso8601 | default('(未采集 facts)') }}

{# rollback_version 只有回滚那条路会给。不能沿用 `version`：CI 传的
   -e version= 是 extra-vars，Ansible 里没有任何东西盖得过它 —— 2026-08-28
   的回滚就是这么空转的（rescue 里 vars: version=prev_version 被无声顶掉，
   模板渲出同一个新版本，compose 看不到变化，「已还原」是句假话）。#}
CORTEX_VERSION=v{{ rollback_version | default(version) }}
CORTEX_REGISTRY={{ cortex_registry }}

DOMAIN={{ cortex_domain }}
CORTEX_PUBLIC_URL={{ cortex_public_url }}

CORTEX_PG_USER={{ cortex_pg_user }}
CORTEX_PG_DB={{ cortex_pg_db }}

S3_ENDPOINT={{ s3_endpoint }}
S3_BUCKET={{ s3_bucket }}
S3_REGION={{ s3_region }}

CORTEX_MEMORY_URL={{ cortex_memory_url }}

CORTEX_LLM_PROVIDER={{ cortex_llm_provider }}
CORTEX_LLM_MODEL={{ cortex_llm_model }}
CORTEX_LLM_CHEAP_MODEL={{ cortex_llm_cheap_model }}

{# ── compose profile 的并集 ───────────────────────────────
   ⚠️ **一行，由所有开关算出来。**

   原先 `COMPOSE_PROFILES=sandbox` 钉在下面沙箱那个分支里，于是
   「只开异地备份、不开沙箱」这个组合下整行都不会出现 —— backup
   那个 profile 没激活，compose 根本不认识这个服务，而部署照样全绿。
   这正是本仓库记过的「配置有两份，改了一处」。

   加第三个 profile 时改这里，不要再回到分支里去写。 #}
{% set _profiles = [] %}
{% if cortex_sandbox_enabled %}{% set _ = _profiles.append('sandbox') %}{% endif %}
{% if cortex_backup_enabled %}{% set _ = _profiles.append('backup') %}{% endif %}
{% if _profiles %}
COMPOSE_PROFILES={{ _profiles | join(',') }}
{% endif %}

{% if cortex_sandbox_enabled %}
# ── 云沙箱：开 ────────────────────────────────────────────
# ⚠️ CORTEX_DOCKER_SOCK 把这台机器的 root 交给了 agentd
CORTEX_SANDBOX_ENABLED=1
CORTEX_DOCKER_SOCK=/var/run/docker.sock
CORTEX_DOCKER_GID={{ cortex_docker_gid }}
CORTEX_EGRESS_ALLOW={{ cortex_egress_allow }}
CORTEX_EGRESS_DENY={{ cortex_egress_deny }}
{% else %}
# ── 云沙箱：关 ────────────────────────────────────────────
# 关着时 CORTEX_DOCKER_SOCK 保持默认的 /dev/null —— agentd 拿不到
# docker API，preflight 会说清原因然后关掉沙箱继续跑
CORTEX_SANDBOX_ENABLED=0
{% endif %}

# ── 发信（阿里云邮件推送）──────────────────────────────
# ⚠️ 两个凭据（CORTEX_MAIL_ACCESS_KEY_ID / _SECRET）**不在这里** ——
# 它们在人工维护的 .env.secrets 里，ansible 从不碰。见 CLAUDE.md「部署」
CORTEX_MAIL_FROM={{ cortex_mail_from }}
CORTEX_MAIL_FROM_ALIAS={{ cortex_mail_from_alias }}
CORTEX_MAIL_ENDPOINT={{ cortex_mail_endpoint }}
CORTEX_MAIL_REGION={{ cortex_mail_region }}

CORTEX_BACKUP_DIR={{ cortex_backup_dir }}

{% if cortex_backup_enabled %}
# ── 异地备份：rustic（PG）+ rclone（RustFS）→ OSS ──────────
# ⚠️ 五个凭据（OSS_ACCESS_KEY_ID / OSS_SECRET_ACCESS_KEY /
# CORTEX_BACKUP_PASSWORD / OSS_BUCKET / OSS_ENDPOINT）**不在这里** ——
# 它们在人工维护的 .env.secrets 里，ansible 从不碰。见 CLAUDE.md「部署」
BACKUP_HOUR={{ backup_hour }}
KEEP_DAILY={{ keep_daily }}
KEEP_WEEKLY={{ keep_weekly }}
KEEP_MONTHLY={{ keep_monthly }}
CORTEX_BACKUP_CHECK_DOW={{ cortex_backup_check_dow }}
CORTEX_BACKUP_CPU_LIMIT={{ cortex_backup_cpu_limit }}
CORTEX_BACKUP_MEM_LIMIT={{ cortex_backup_mem_limit }}
{% else %}
# ── 异地备份：关 ──────────────────────────────────────────
# 只有本机备份，而本机备份防不住整机丢失。开它见 docs/backup.md
{% endif %}

AGENTD_CPU_LIMIT={{ agentd_cpu_limit }}
AGENTD_MEM_LIMIT={{ agentd_mem_limit }}
CORTEX_PG_CPU_LIMIT={{ cortex_pg_cpu_limit }}
CORTEX_PG_MEM_LIMIT={{ cortex_pg_mem_limit }}
CORTEX_EGRESS_CPU_LIMIT={{ cortex_egress_cpu_limit }}
CORTEX_EGRESS_MEM_LIMIT={{ cortex_egress_mem_limit }}

AGENTD_LOG={{ agentd_log }}
CORTEX_EGRESS_LOG={{ cortex_egress_log }}
