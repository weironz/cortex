+            .record_approved(id, "computer_act", &json!({"text":"approved"}), TOKEN)
+            .unwrap();
+        assert!(
+            tracker
+                .bind_parts(id, true, "computer_act", &json!({"text":"changed"}))
+                .is_err(),
+            "换参数不能借用审批"
