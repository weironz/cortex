+        );
+    }
+
+    #[test]
+    fn pending_and_consumed_operations_share_the_bound() {
+        let tracker = DispatchCorrelation::default();
+        let ids: Vec<_> = (0..MAX_OPERATIONS).map(|_| Id::new()).collect();
+        for id in &ids {
