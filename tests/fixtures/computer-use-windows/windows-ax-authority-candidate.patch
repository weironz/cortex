+        let batch = ref_batch(&mut template);
+        let mut before = Observation::new(
+            template.frame().clone(),
+            template.window().clone(),
+            vec![
+                ObservedElement::new(
+                    ElementRefId::new("save-ref").expect("ref"),
+                    Some("button".into()),
+                    Some("Save".into()),
