diff --git a/libs/cua-driver/rust/crates/platform-windows/src/uia/native_ref.rs b/libs/cua-driver/rust/crates/platform-windows/src/uia/native_ref.rs
new file mode 100644
index 0000000..d58e8c5
--- /dev/null
+++ b/libs/cua-driver/rust/crates/platform-windows/src/uia/native_ref.rs
@@ -0,0 +1,51 @@
+use std::mem::ManuallyDrop;
+use windows::core::{IUnknown, Interface};
+
+/// 节点拥有的一个 COM 引用；裸指针只是借用视图，不能代替拥有者。
+/// 用 IUnknown 的公共 ABI 处理 UIA/MSAA，沿用原有 MTA worker 的传递约定。
+#[derive(Debug, Default)]
+pub(crate) struct NativeRef {
+    ptr: usize,
+}
+
+impl NativeRef {
+    pub(crate) fn from_interface<T: Interface>(element: &T) -> Self {
+        // clone 在交出局部包装之前取得独立引用，错误或截断也由节点自动归还。
+        unsafe { Self::from_raw(element.clone().into_raw() as usize) }
+    }
+
+    /// 接管已有引用，不执行 AddRef；空指针表示没有本机元素的元数据行。
+    ///
+    /// # Safety
+    /// 非空指针必须是带有一个可转移引用的活 COM 接口；调用后原拥有者不得再 Release。
+    pub(crate) unsafe fn from_raw(ptr: usize) -> Self {
+        Self { ptr }
+    }
+
+    pub(crate) fn as_ptr(&self) -> usize {
+        self.ptr
+    }
+
+    pub(crate) fn into_raw(mut self) -> usize {
+        std::mem::replace(&mut self.ptr, 0)
+    }
+}
+
+impl Clone for NativeRef {
+    fn clone(&self) -> Self {
+        if self.ptr == 0 {
+            return Self::default();
+        }
+        // ManuallyDrop 只借用本引用；复制出的 IUnknown 才是新增的拥有者。
+        let borrowed = unsafe { ManuallyDrop::new(IUnknown::from_raw(self.ptr as *mut _)) };
+        unsafe { Self::from_raw((*borrowed).clone().into_raw() as usize) }
+    }
+}
+
+impl Drop for NativeRef {
+    fn drop(&mut self) {
+        if self.ptr != 0 {
+            unsafe { drop(IUnknown::from_raw(self.ptr as *mut _)) };
+        }
+    }
+}
