# ══════════════════════════════════════════════════════════
#  开发环境的 nginx —— 静态产物 + **同源反代 cortexd**
#
#  与生产那份（nginx.conf）的唯一差别：这里带反代。
#  生产的路由分流在 traefik 那一层（见 deploy/docker-compose.yml 的
#  `PathPrefix(/api)`），nginx 只发静态文件。
#
#  ── 为什么开发环境要同源 ──────────────────────────────────
#
#  cortexd 默认**不允许任何跨源请求**（cors.rs：生产形态是 Web 与 cortexd
#  同源）。开发时若让浏览器直接打 :8080，就得开 CORS —— 而那时测的是一条
#  **生产上不存在**的路径，CORS 相关的坑一个都碰不到、也碰不着。
#
#  所以这里让 nginx 同时发静态和转 API：浏览器眼里只有一个源，
#  与部署形态一致。
# ══════════════════════════════════════════════════════════

# 记忆服务在哪儿。**它不在这个仓库里** —— 见 github.com/weironz/cormex。
#
# 从此是一个**部署参数**，不是一个 compose 服务名：Cortex 只部署 agent
# 那一半（agentd + web），记忆服务由 Cormex 自己的 compose 起。
# 用 nginx 官方镜像的 templates 机制注入（`${VAR}` 在容器启动时 envsubst）。
#
# 开发机默认走 `host.docker.internal` —— Cormex 的 compose 把 8080 发布在
# 宿主上，而这个容器要跨出自己的网络才够得着它。
upstream cortexd {
    server ${CORTEX_MEMORY_UPSTREAM};
    keepalive 32;
}

# agent 编排在 compose 网络里的名字。见下面那段 `/chat|/sandbox` 的 location。
upstream agentd {
    server agentd:8081;
    keepalive 32;
}

server {
    listen       80;
    listen       [::]:80;
    server_name  _;
    root         /usr/share/nginx/html;
    index        index.html;

    # 上传附件、导入 conversations.json 都可能很大。
    # nginx 默认 1M，超了直接 413 —— 而那条错误不经过 cortexd，
    # 日志里什么都没有
    client_max_body_size 512m;

    # ── API 反代 ─────────────────────────────────────────
    #
    # **白名单而不是「文件不存在就转发」。** 后者写起来短，但漏掉一条的
    # 症状是「深链接刷新后拿到一个 JSON」。
    #
    # 这份清单要与 `crates/cortexd/src/routes.rs` 的 `protected_routes!`
    # 对得上。加了新的顶层路由记得加这里 —— 不加的话它在 Web 上不存在。
    #
    # ⚠️ 这条注释以前写着「漏掉一条的症状是一个响亮的 404」。**那是错的**，
    # 2026-08-15 被 `/settings/llm-key` 证伪：漏掉的路径落到下面的 SPA
    # 回落上，回的是 **200 + 一整个 index.html**。调用方看到的是「JSON 解析
    # 失败」，离真正的原因隔着两层，于是那个界面显示「读不出状态」，
    # 而错误提示还把人往 `/api` 指（dev 根本没有 /api）。
    # 光靠「记得加这里」防不住，所以回落那段现在会对明说要 JSON 的请求
    # 拒发网页 —— 见文件末尾的 `@spa`。
    #
    # **生产没有这个问题**：traefik 那侧是单一 `/api` 前缀（只按第二段把
    # `/api/chat`、`/api/sandbox` 分给 agentd），加新路由不需要动任何配置。
    # 会漂移的只有这份手工清单 —— 也就是说这类 bug 只会在开发机上出现，
    # 且只在开发机上被发现，正是最容易被当成「本地环境的问题」放过的那种。
    #
    # ── `/chat` 与 `/sandbox/*` 不在这一段，它们去 agentd ──
    #
    # **分流在这里，不在任何一个服务里。** 拆成两个进程之后总得有人知道
    # 「哪条路归谁」，而让 cortexd 知道 agentd 在哪，等于给要独立开源的那一半
    # 留一条「agent 服务地址」的配置 —— 那正是这次拆分要消灭的耦合。
    # 边缘本来就在做路径分流，这件事放它这儿一行配置都不多。
    #
    # ── 已经搬到 agentd 的，从这份清单里逐条删掉 ──
    #
    # 2026-08-16 删掉了 `sessions`、`auth`、`health`：
    #
    # - `auth` —— 身份已经住在 agentd（登录签的 access token 是**进程内存**
    #   里的一本簿子，签发方与校验方必须是同一个进程；指向别处的直接后果是
    #   「登录成功，然后每一个请求 401」）
    # - `health` —— 客户端连接页拿它验地址。指向一个已经不存在的服务，
    #   人还没来得及填用户名就被判成「连不上」
    # - `sessions` / `projects` —— 会话与项目，数据在 Cortex 自己的库里。
    #   **两个必须同一批切**：`PATCH /sessions/{id}` 的 `project_id` 要先确认
    #   目标项目存在，分两批的话中间那一版会向一个自己读不到的库问
    #   「这个项目在不在」，而答案恒为「不在」
    #
    # **删而不是加豁免** —— 一条路径同时出现在两个 location 里时，nginx 按
    # 先后取第一个匹配的，于是「我明明改了」与「它没生效」会同时成立。
    #
    # 这份清单会一直缩短，最后只剩记忆那一侧真正的路由（memory、mcp）。
    location ~ ^/(confirmations|memory|llm|episodes|blobs|sync|import|settings|sandbox-snapshots|delegated-tokens|mcp)(/|$) {
        proxy_pass http://cortexd;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # ── SSE 必须关掉缓冲 ──
        #
        # `/chat` 是一条 SSE 流。nginx 默认会缓冲响应，于是 token 攒够
        # 一个 buffer 才吐给浏览器 —— 表现是「模型不流式了，等半天一次性
        # 蹦出来」，而 cortexd 那侧看一切正常。
        #
        # `X-Accel-Buffering: no` 是同一件事的另一半（上游主动关缓冲用的）,
        # 这里两边都写死，省得依赖上游记得发那个头
        proxy_buffering    off;
        proxy_cache        off;
        chunked_transfer_encoding on;

        # 一轮对话可以跑很久（容器里的上限是 30 分钟）。nginx 默认 60 秒
        # 读超时，到点直接掐断连接 —— 症状是「长任务总在一分钟左右断」
        proxy_read_timeout    1800s;
        proxy_send_timeout    1800s;
        proxy_connect_timeout 10s;
    }

    # ── agent 编排：/chat 与 /sandbox/* ──────────────────
    #
    # 与上面那段的配置逐字相同（SSE 关缓冲、30 分钟读超时），只有上游不同。
    # 不合并成一段再按前缀选上游：nginx 里那么写要引一个 map，而两段各自
    # 完整、读得出「这条归谁」，比省下十行重要。
    location ~ ^/(chat|sandbox|sessions|projects|auth|health)(/|$) {
        proxy_pass http://agentd;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # `/chat` 是 SSE，理由同上面那段
        proxy_buffering    off;
        proxy_cache        off;
        chunked_transfer_encoding on;

        proxy_read_timeout    1800s;
        proxy_send_timeout    1800s;
        proxy_connect_timeout 10s;
    }

    # ── WebSocket ────────────────────────────────────────
    #
    # 单独一段：`/ws` 要 101 升级，而升级要 `Upgrade`/`Connection` 两个头。
    # 混进上面那段的话，那两个头会被 keepalive 的 `proxy_http_version 1.1`
    # 之外的默认行为吃掉，症状是握手回 200 而不是 101，
    # 客户端一直在重连而日志里没有任何错误
    location /ws {
        proxy_pass http://cortexd;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host       $host;
        proxy_read_timeout 1800s;
    }

    # ── 静态 ─────────────────────────────────────────────
    #
    # Flutter Web 是单页应用：深链接在磁盘上没有对应文件，回落 index.html。
    location / {
        try_files $uri $uri/ @spa;
    }

    # ── SPA 回落：对 API 调用要响亮地失败 ────────────────────
    #
    # 上面的白名单漏一条时，请求会走到这里拿到 200 + 一整个网页。**那是
    # 这个部署里最贵的一类假信号**：调用方报的是「JSON 解析失败」或
    # 「这个地址返回的是网页」，而真正的原因（nginx 少一行）在两层之外。
    # `/settings/llm-key` 就这么静默坏了一整个版本 —— 界面上那一格永远
    # 显示「读不出状态」，没人会想到去看反代配置。
    #
    # 所以：**明说要 JSON 的请求一律不给 index.html。** 客户端每个
    # `_getJson` 都带 `accept: application/json`（http_cortex_api.dart），
    # 浏览器导航带的是 `text/html`，两者分得干净。
    #
    # 为什么是**独立的命名 location** 而不是在 `location /` 里判断：
    # 那样 `if` 会先于 `try_files` 执行，于是磁盘上真实存在的
    # `AssetManifest.json` 之类也会被拒掉。放在回落里，只有「文件不存在」
    # 时才判断，真实文件照常发。
    location @spa {
        # `default_type` 只在**扩展名认不出类型**时才生效，所以放在 location
        # 层不会影响下面那个 index.html（`.html` 在 mime.types 里有）。
        # 写在 `if` 里 nginx 直接拒绝启动（"not allowed here"）
        default_type application/json;

        if ($http_accept ~* application/json) {
            return 404 '{"error":"no such API route — 这个路径没有落在 nginx 的反代白名单里，检查 scripts/docker/nginx.dev.conf.template"}';
        }
        try_files /index.html =404;
    }

    # 开发环境**一律不缓存**。生产那份有精细的缓存策略，这里反过来 ——
    # 改完 `flutter build web` 之后刷新看不到新版本，是开发时最浪费时间的
    # 一类困惑，而开发机上省那点带宽毫无意义
    add_header Cache-Control "no-store, must-revalidate" always;

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }
}
