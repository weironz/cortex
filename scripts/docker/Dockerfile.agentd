# ══════════════════════════════════════════════════════════
#  cortex-agentd 生产镜像
#
#  构建（在仓库根执行）：
#    docker build -f scripts/docker/Dockerfile.agentd -t cortex/agentd .
#  或直接：
#    just prod-build
#
#  ── 它是什么 ─────────────────────────────────────────────
#
#  云端 agent 的**编排器**：按需拉起沙箱容器、把请求逐字节反代进去、
#  在容器闲下来时回收。对话循环不在这儿 —— 那在容器里那个 cortex-local
#  上（同一个二进制，`--exec-env=container`）。
#
#  ── 它需要 docker.sock ───────────────────────────────────
#
#  **这是把宿主 root 交给它。** 论证的另一半是容器规格全部写死在
#  `DockerRunner` 里：调用方说不出第二个挂载、改不了网络、加不了能力。
#  compose 里给的是 group_add 而不是 user: root —— 进程仍然不是 root，
#  只是拿到那个 socket 的 660 group rw，比 root 小一格而效果一样。
#
#  ── 它**不**需要数据库 ───────────────────────────────────
#
#  没有 DATABASE_URL、没有对象存储凭据。记忆走 HTTP
#  （`POST /delegated-tokens` 要钥匙、`/blobs` 存快照字节），
#  而记忆服务在另一个仓库：github.com/weironz/cormex。
# ══════════════════════════════════════════════════════════

# ── 构建阶段 ──────────────────────────────────────────────
#
# 构建与运行底座**必须同一个 debian 代号**：二进制动态链 glibc，
# 新 glibc 编的东西放进老底座会在启动时报 `GLIBC_2.xx not found`。
FROM rust:1.97.1-trixie AS builder

WORKDIR /build

# 先只拷清单，让「依赖没变就复用上一层」这件事真的发生。
# 直接 COPY . . 会让任何一次源码改动都重编全部依赖树（goose 供应商层是
# 几百个 crate，冷编按十分钟计）。
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates/cortex-core/Cargo.toml    crates/cortex-core/
COPY crates/cortex-llm/Cargo.toml     crates/cortex-llm/
COPY crates/cortex-agent/Cargo.toml   crates/cortex-agent/
COPY crates/cortex-proto/Cargo.toml   crates/cortex-proto/
COPY crates/cortex-import/Cargo.toml  crates/cortex-import/
COPY crates/cortex-blob/Cargo.toml    crates/cortex-blob/
COPY crates/cortex-agentd/Cargo.toml  crates/cortex-agentd/
COPY crates/cortex-local/Cargo.toml   crates/cortex-local/
COPY crates/cortex-cli/Cargo.toml     crates/cortex-cli/
COPY crates/cortex-egress-proxy/Cargo.toml crates/cortex-egress-proxy/
COPY crates/cortex-store/Cargo.toml   crates/cortex-store/

# 占位 src，让依赖层能单独编出来再被缓存
RUN for d in crates/*/; do \
        mkdir -p "$d/src"; \
        if grep -q '\[\[bin\]\]\|name = "cortex' "$d/Cargo.toml"; then \
            echo 'fn main() {}' > "$d/src/main.rs"; \
        fi; \
        echo '' > "$d/src/lib.rs"; \
    done && \
    cargo build --release -p cortex-agentd 2>/dev/null || true

# 真正的源码
COPY crates/ crates/

# **migration 目录是编译期输入，不是运行期资源。** `cortex-store` 用
# `sqlx::migrate!()` 把这两个目录整个嵌进二进制里 —— 少了它们，报的是
#
#   error canonicalizing migration directory /build/.../migrations: No such file
#
# 而这个错**只在容器里出现**：CI 与本机都在完整的仓库树上编，那两个目录
# 天然就在。第一次发现它是 v0.1.10 的镜像作业红了，而同一份代码的 CI 全绿。
COPY migrations/ migrations/
COPY migrations-global/ migrations-global/

# 构建时的 git 提交，烧进 `/health` 的 `commit` 字段。
#
# **必须由外面传进来**：`.dockerignore` 把 `.git` 挡在构建上下文外面
# （那是对的，几十兆没必要进镜像），所以镜像里跑 git 问不出东西。
# 传不进来就是 `unknown` —— 见 `crates/cortex-core/build.rs`。
#
# ⚠️ 位置**必须在依赖那几层之后**。放前面的话，每个提交都会换掉一个
# 早期层，把后面几百个 crate 的缓存全部作废 —— 一次冷编按十分钟计。
ARG CORTEX_GIT_SHA=unknown

# 占位留下的时间戳会让 cargo 以为没变。touch 一遍强制重编真源码
RUN find crates -name '*.rs' -exec touch {} + && \
    CORTEX_GIT_SHA="${CORTEX_GIT_SHA}" cargo build --release -p cortex-agentd

# ── 运行阶段 ──────────────────────────────────────────────
FROM debian:trixie-slim

# ca-certificates：agentd 要连记忆服务（可能是 https）。
#   缺了它的症状是「所有请求都失败」而日志只说 tls 握手错。
# curl：下面的 HEALTHCHECK 用。
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*

# 与 Cormex 的 cortexd 镜像同一个 uid：两边写出来的数据文件属主一致，
# 出问题时不必猜是谁写的
RUN useradd -u 10001 -m -s /usr/sbin/nologin cortex

COPY --from=builder /build/target/release/cortex-agentd /usr/local/bin/cortex-agentd

USER 10001
EXPOSE 8081

# ★ **没有这一条，每一次部署都会失败。** 节点上的部署脚本靠
# `docker inspect --format '{{.State.Health.Status}}'` 判断新版本起没起来，
# 而一个没有 HEALTHCHECK 的容器在那里永远返回 `<no value>` —— 不是
# unhealthy（那还能看出问题），是**一个读起来像「还没就绪」的空值**。
# 于是循环跑满 10 分钟，报「agentd 没有健康」，回滚掉一次完全正常的部署。
#
# 打 `/health` 而不是 `/sandbox/health`：两条路由是同一个 handler，
# 但容器内探针走 127.0.0.1、不经边缘，用哪条都行 —— 取短的那条。
#
# 端口从 `CORTEX_AGENTD_BIND` 里剥出来，**不硬编码 8081**：那个变量是
# compose 配的，两处各写一个数字迟早会分家，而分家的症状是「服务好好的、
# 探针永远红」。`##*:` 砍掉 host 那一半，默认值兜住没配的情况。
#
# ★ 它**不检查记忆服务连不连得上**（`/health` 里那个 `memory_reachable`
#   字段为 false 时这条仍然算过）。刻意的：容器探针答的是「这个进程活着
#   吗」，答「否」会让 docker 反复重启它 —— 而记忆服务掉线时重启 agentd
#   什么也解决不了，只会把日志冲掉。那一条由部署验证断言，见 deploy.yml。
#
# start-period 给 30 秒：启动时要跟 docker daemon 握一次手（握不上就直接
# 退出），daemon 忙时那一下不快。比记忆服务的 90 秒短 —— 它不连数据库，
# 也不跑 migration。
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
    CMD p="${CORTEX_AGENTD_BIND:-0.0.0.0:8081}"; \
        curl -fsS "http://127.0.0.1:${p##*:}/health" || exit 1

ENTRYPOINT ["/usr/local/bin/cortex-agentd"]
