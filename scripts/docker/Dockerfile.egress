# ══════════════════════════════════════════════════════════
#  cortex-egress-proxy —— 沙箱网段唯一的双宿出口
#
#  沙箱网段是 internal（容器里连默认路由都没有），这个容器同时接
#  internal 网段与普通网桥，两个方向都由它做：
#
#    沙箱 ──HTTP(S)_PROXY──► 这里 ──► 放行清单内的外网 / 宿主
#      ▲                       │
#      └── cortexd 反代进来 ───┘（这个容器的 publish 端口）
#
#  完整设计与那几条真机实测见 docs/sandbox.md 第八节。
#
#  构建（在仓库根执行）：
#    docker build -f scripts/docker/Dockerfile.egress -t cortex/egress-proxy .
# ══════════════════════════════════════════════════════════

FROM rust:1.98.0-trixie AS builder

# **静态链 musl，运行阶段才能是 scratch。** 理由见下面运行阶段那段。
# musl-tools 给的是链接期要的 musl-gcc，rustup 那行给的是交叉标准库。
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends musl-tools; \
    rm -rf /var/lib/apt/lists/*; \
    rustup target add x86_64-unknown-linux-musl

WORKDIR /build

# 与另外两个 Dockerfile 同一套「先拷清单再拷源码」的分层。
# 这里的收益比那两个还大：这个 crate 只依赖 tokio + tracing，
# 依赖层几乎永远命中。
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates/cortex-core/Cargo.toml         crates/cortex-core/
COPY crates/cortex-llm/Cargo.toml          crates/cortex-llm/
COPY crates/cortex-agent/Cargo.toml        crates/cortex-agent/
COPY crates/cortex-blob/Cargo.toml         crates/cortex-blob/
COPY crates/cortex-proto/Cargo.toml        crates/cortex-proto/
COPY crates/cortex-import/Cargo.toml       crates/cortex-import/
COPY crates/cortex-local/Cargo.toml        crates/cortex-local/
COPY crates/cortex-cli/Cargo.toml          crates/cortex-cli/
COPY crates/cortex-egress-proxy/Cargo.toml crates/cortex-egress-proxy/
COPY crates/cortex-agentd/Cargo.toml      crates/cortex-agentd/

RUN set -eux; \
    for d in crates/*/ evals/; do \
        mkdir -p "$d/src"; \
        echo '' > "$d/src/lib.rs"; \
        echo 'fn main() {}' > "$d/src/main.rs"; \
    done; \
    cargo build --release --target x86_64-unknown-linux-musl \
        -p cortex-egress-proxy 2>/dev/null || true

COPY crates/ crates/

RUN set -eux; \
    find crates evals -name '*.rs' -exec touch {} +; \
    cargo build --release --target x86_64-unknown-linux-musl -p cortex-egress-proxy
# 不用手工 strip：[profile.release] 里 strip = true 已经做了（实测 1.64 MB）

# ── 运行阶段 ──────────────────────────────────────────────
#
# **整个镜像只有一个 1.64 MB 的静态二进制，没有第二个文件。**
#
# 它跑在信任边界上：沙箱里所有出网流量都经过它，而它自己有默认路由。
# 镜像里多一个可执行文件，就多一个被攻陷后能用的东西 —— scratch 里连
# `sh` 都没有，命令注入那类手法在这里根本没有落脚点。
#
# 上一版是 debian:trixie-slim + ca-certificates（**125 MB 装 1.6 MB**），
# 理由写的是「将来要加健康检查/上报就不必换基镜像」。那是拿真实的攻击面
# 去换想象中的需求，而且和上面那句自己写下的原则直接打架。这个代理不发起
# TLS —— CONNECT 是纯字节转发，TLS 在沙箱与目标之间端到端 —— 信任根一张都用不上。
#
# scratch 上照样成立的两件事，都是 docker 运行时注入的，不靠镜像：
#   /etc/resolv.conf、/etc/hosts   musl 的解析器直接读这两个文件
#   uid                            用数字写，因为没有 /etc/passwd 可查
FROM scratch AS runtime

COPY --from=builder \
     /build/target/x86_64-unknown-linux-musl/release/cortex-egress-proxy \
     /cortex-egress-proxy

# 数字形式的 uid。10003 与 cortexd（10001）、沙箱（10002）错开
USER 10003:10003

# 3128 = 出网代理（沙箱侧，**不 publish**，只在 internal 网段里可见）
# 3129 = 反向中继（cortexd 侧，publish 到宿主 127.0.0.1）
EXPOSE 3128 3129

ENV RUST_LOG=cortex_egress_proxy=info,warn

ENTRYPOINT ["/cortex-egress-proxy"]
