# ══════════════════════════════════════════════════════════
#  cortex-web 生产镜像 —— Flutter Web 静态产物 + nginx
#
#  构建（在仓库根执行）：
#    docker build -f scripts/docker/Dockerfile.web -t cortex/cortex-web .
#
#  指定 API 地址（见下方那段长注释，这是这个镜像唯一的旋钮）：
#    docker build -f scripts/docker/Dockerfile.web \
#        --build-arg CORTEX_BASE_URL=https://cortex.cloudcele.com/api \
#        -t cortex/cortex-web .
# ══════════════════════════════════════════════════════════

# ── 构建阶段 ──────────────────────────────────────────────
# Flutter 官方没有出 docker 镜像，社区镜像质量参差。这里从 debian 起手
# 自己拉 SDK：多几行，但能把版本钉死，而且不引入一个来路不明的第三方镜像
# 到发布链路里。
FROM debian:trixie-slim AS builder

ARG FLUTTER_VERSION=3.44.1

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates curl git unzip xz-utils; \
    rm -rf /var/lib/apt/lists/*

# 官方 tar 包而不是 `git clone -b`：clone 会拉整个 flutter 仓库历史
# （几百 MB 且每次构建都变），tar 包是固定内容，层缓存才有意义
RUN set -eux; \
    curl -fsSL -o /tmp/flutter.tar.xz \
      "https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_${FLUTTER_VERSION}-stable.tar.xz"; \
    tar -xf /tmp/flutter.tar.xz -C /opt; \
    rm /tmp/flutter.tar.xz
ENV PATH="/opt/flutter/bin:${PATH}"

# flutter 3.x 起会拒绝在「别人的」git 仓库里跑。容器里是 root 且
# /opt/flutter 是解压出来的，声明一下 safe.directory 免得每条命令都警告
RUN git config --global --add safe.directory /opt/flutter \
    && flutter --version \
    && flutter config --no-analytics

WORKDIR /build

# 先只拷 pubspec，让依赖解析层在业务代码改动时命中缓存
COPY app/pubspec.yaml app/pubspec.lock* ./app/
WORKDIR /build/app
RUN flutter pub get

# 真正的源码
WORKDIR /build
COPY app/ ./app/
WORKDIR /build/app

# ── 唯一的旋钮：API 地址 ──────────────────────────────────
#
# **这个值是编译期钉死的，运行期改不了。**
#
# 客户端的 `AppConfig.defaultBaseUrl` 是 `String.fromEnvironment`，
# dart2js 会把它当成常量折叠进 main.dart.js。nginx 启动时替换字符串
# 那一套在这里行不通 —— 压缩混淆后的 JS 里没有一个稳定的占位符可替。
#
# 还有一条更硬的限制：`HttpCortexApi._normalise` 只接受 http:// 或
# https:// 开头的绝对地址，**相对路径 `/api` 会被拼成 `http:///api`**
# 这种没有 host 的废 URI。所以「同源部署」也必须写完整域名：
#
#     CORTEX_BASE_URL=https://cortex.cloudcele.com/api
#
# 好在路径前缀是保住的（`_uri` 里做的是 `_base.path + path`），
# 于是 /health 变成 /api/health、ws 变成 wss://…/api/ws，
# 与 traefik 那侧的 StripPrefix 正好对上。
#
# 留空 = 用应用自带的默认值 http://127.0.0.1:8080，运行期可以在设置面板里改。
# 那是「通用镜像」的形态；固定域名的自托管部署应当把它填上，
# 否则每个用户第一次打开都要先去设置里填一遍地址。
ARG CORTEX_BASE_URL=""

RUN set -eux; \
    if [ -n "$CORTEX_BASE_URL" ]; then \
        echo "API base 钉为 $CORTEX_BASE_URL"; \
        flutter build web --release --dart-define=CORTEX_BASE_URL="$CORTEX_BASE_URL"; \
    else \
        echo "API base 用应用默认值（运行期可在设置面板改）"; \
        flutter build web --release; \
    fi

# 构建期就验一次，别等部署完才发现钉错了。
# dart2js 会把常量原样留在输出里，grep 得到 = 折叠确实发生了
RUN set -eux; \
    if [ -n "$CORTEX_BASE_URL" ]; then \
        grep -qF "$CORTEX_BASE_URL" build/web/main.dart.js \
          || { echo "错误：main.dart.js 里找不到 $CORTEX_BASE_URL —— dart-define 没有生效"; exit 1; }; \
    fi; \
    test -f build/web/index.html

# ── 运行阶段 ──────────────────────────────────────────────
FROM nginx:1.29-alpine AS runtime

# 默认站点配置会与我们的冲突（两个 server 抢 80），删掉而不是覆盖 ——
# 覆盖时如果文件名写错，生效的是默认那份，而它「看起来也能工作」
RUN rm -f /etc/nginx/conf.d/default.conf
COPY scripts/docker/nginx.conf /etc/nginx/conf.d/cortex.conf
COPY --from=builder /build/app/build/web /usr/share/nginx/html

# nginx:alpine 的 master 需要 root 起（要 bind :80 并写 pid），
# worker 已经降到 nginx 用户。这里不改成非 root：改了要连带调端口、
# 调 pid 路径、调临时目录，而这个容器不接触任何数据 ——
# 它只发静态文件，攻击面本来就只有 nginx 自己。
EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -q --spider http://127.0.0.1/healthz || exit 1
