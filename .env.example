# 复制为 .env 后按需修改。.env 已被 .gitignore 排除，绝不入库。

# ─── Postgres ───────────────────────────────────────────
# 端口刻意避开 5432 / 9000 / 9001 等常见默认值，
# 以免与本机其他项目的 Postgres、MinIO/RustFS 冲突。
POSTGRES_USER=cortex
POSTGRES_PASSWORD=cortex_dev_only
POSTGRES_DB=cortex
POSTGRES_PORT=5442

DATABASE_URL=postgres://cortex:cortex_dev_only@localhost:5442/cortex

# ─── RustFS（S3 兼容对象存储）────────────────────────────
RUSTFS_ACCESS_KEY=cortexadmin
RUSTFS_SECRET_KEY=cortex_dev_only
RUSTFS_API_PORT=9010
RUSTFS_CONSOLE_PORT=9011

# 四卷纠删码要求四块独立物理盘。开发机通常只有一块，
# RustFS 会检测到共享设备并拒绝启动 —— 这是正确的安全行为。
# 开发环境置 true 跳过检查；【生产环境必须为 false 且挂真实独立磁盘】。
RUSTFS_UNSAFE_BYPASS_DISK_CHECK=true

S3_ENDPOINT=http://localhost:9010
S3_BUCKET=cortex-blobs
S3_REGION=us-east-1

# ─── cortexd ────────────────────────────────────────────
CORTEXD_BIND=127.0.0.1:8080
RUST_LOG=cortexd=debug,cortex_core=debug,info

# ─── LLM 供应商（按需填写，不要提交真实密钥）──────────────
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=

# ─── 备份与灾备 ─────────────────────────────────────────
# 全都有默认值，开发机不用改。细节见 docs/operations.md。
# 【生产必改】备份根要指到与数据盘不同的物理盘 —— 和数据同盘的备份
# 防得住误删，防不住盘坏，而盘坏才是备份存在的理由。
CORTEX_BACKUP_DIR=./data/backup
# 第二存储。不配就只镜像到本机目录 CORTEX_MIRROR_DIR ——
# 那同样防不住整机丢失，脚本每次跑都会明说这一点。
CORTEX_MIRROR_DIR=./data/mirror
# CORTEX_MIRROR_S3_ENDPOINT=
# CORTEX_MIRROR_S3_ACCESS_KEY=
# CORTEX_MIRROR_S3_SECRET_KEY=
# CORTEX_MIRROR_S3_BUCKET=

# Postgres 数据卷名，just pg-enable-checksums 要用它离线挂载
PG_VOLUME=cortex_pg_data
# 想钉版本就改这里，默认跟 latest
RCLONE_IMAGE=rclone/rclone:latest

# ─── 生产部署（docker-compose.prod.yml 才读）─────────────
# 对外绑定。默认只听回环；要对公网提供服务请放在反代之后。
# CORTEXD_PUBLIC_BIND=127.0.0.1:8080
# 四卷纠删码的四块盘。必须是四个**独立块设备**，
# 挂同一块盘是假冗余，RustFS 会拒绝启动 —— 那是正确行为。
#   lsblk -o NAME,MOUNTPOINT,PKNAME
# RUSTFS_DISK0=/mnt/disk0
# RUSTFS_DISK1=/mnt/disk1
# RUSTFS_DISK2=/mnt/disk2
# RUSTFS_DISK3=/mnt/disk3

# ─── 媒体转录（可选）────────────────────────────────────
# 不设则整条关闭：图片照常归档，只是检索不到。
# 刻意不给默认值——配个假的转录器会往库里写垃圾 caption，而垃圾比空白更难发现。
# DeepSeek 目前没有 vision 能力，本机 ollama 是最省事的选择。
# CORTEX_VISION_PROVIDER=ollama
# CORTEX_VISION_MODEL=gemma4:latest
