# 复制为 .env 后按需修改。.env 已被 .gitignore 排除，绝不入库。

# ─── Postgres ───────────────────────────────────────────
POSTGRES_USER=cortex
POSTGRES_PASSWORD=cortex_dev_only
POSTGRES_DB=cortex
POSTGRES_PORT=5432

DATABASE_URL=postgres://cortex:cortex_dev_only@localhost:5432/cortex

# ─── RustFS（S3 兼容对象存储）────────────────────────────
RUSTFS_ACCESS_KEY=cortexadmin
RUSTFS_SECRET_KEY=cortex_dev_only
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=cortex-blobs
S3_REGION=us-east-1

# ─── cortexd ────────────────────────────────────────────
CORTEXD_BIND=127.0.0.1:8080
RUST_LOG=cortexd=debug,cortex_core=debug,info

# ─── LLM 供应商（按需填写，不要提交真实密钥）──────────────
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
