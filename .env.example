# 复制为 .env 后按需修改。.env 已被 .gitignore 排除，绝不入库。

# ─── Cortex 自己的库 ────────────────────────────────────
#
# 装的是**会话**：消息、附件、项目、同步流水、沙箱快照、自带 API key。
# 记忆（facts / entities / 向量）在另一个产品的库里，不在这儿。
#
# 这几行以前指的是记忆库（端口 15432），它随记忆服务去了 Cormex，
# 而这几行留在了原地 —— 于是照着配只会连到一个不存在的库。
#
# ⚠️ **Windows 上别用 5440–5539 那一段。** WinNAT / Hyper-V 保留了若干
# 端口区间，落在里面时 docker 报「An attempt was made to access a socket
# in a way forbidden by its access permissions」—— 完全看不出是端口被
# 系统占了。本机查：netsh interface ipv4 show excludedportrange protocol=tcp
#
# 5452 是避开那一段、也避开本机别的项目（5432 / 5442）之后选的。
CORTEX_PG_USER=cortex
CORTEX_PG_PASSWORD=cortex
CORTEX_PG_DB=cortex
CORTEX_PG_PORT=5452

# `cargo test -p cortex-store` 读这一条（经 dotenvy 找到仓库根的 .env）。
# 没有它，那些集成测试会**自己跳过**而不是失败 —— 见 tests/common/mod.rs。
DATABASE_URL=postgres://cortex:cortex@127.0.0.1:5452/cortex

# 生产上 agentd 连库用的是服务名，由 deploy/docker-compose.yml 拼出来，
# 不在这里配。要覆盖时才写：
# CORTEX_DATABASE_URL=postgres://user:pass@host:5432/db

# 同时最多几路事实抽取。默认 3。
#
# 不按 CPU 核数算：抽取的瓶颈在**供应商那一端**，本地几乎不耗 CPU。
# 按核数放出几十路并发，撞的是速率限制，而每一个 429 都是一轮记忆丢了。
#
# 正常聊天永远排不上队（人打字比这慢得多）。它挡的是批量写入 ——
# 历史导入是最典型的那个，几千条一起灌能把整台机器连同别的服务拖死。
# CORTEX_EXTRACT_CONCURRENCY=3

# 跑哪个后端：live（默认）/ mock。
#
# **连不上数据库时 cortexd 会退出，不再回落到 mock。** 回落曾经是默认行为，
# 而它的后果是：一次「Postgres 还没起来」的重启，就能让 cortexd 带着一库
# 假记忆对外服务 —— 而且 HTTP 200、status: ok、检索有结果，看不出任何异常。
#
# 想不带数据库跑（改客户端界面、看看空壳长什么样）就明说 mock。
# 那时 /health 会如实报 status: "mock"。
# CORTEX_BACKEND=mock

# ─── RustFS（S3 兼容对象存储）────────────────────────────
RUSTFS_ACCESS_KEY=cortexadmin
RUSTFS_SECRET_KEY=cortex_dev_only
RUSTFS_API_PORT=9010
RUSTFS_CONSOLE_PORT=9011

# 四卷纠删码要求四块独立物理盘。开发机通常只有一块，
# RustFS 会检测到共享设备并拒绝启动 —— 这是正确的安全行为。
# 开发环境置 true 跳过检查；【生产环境必须为 false 且挂真实独立磁盘】。
RUSTFS_UNSAFE_BYPASS_DISK_CHECK=true

S3_ENDPOINT=http://localhost:9010
S3_BUCKET=cortex-blobs
S3_REGION=us-east-1

# ─── cortexd ────────────────────────────────────────────
CORTEXD_BIND=127.0.0.1:8080
RUST_LOG=cortexd=debug,cortex_core=debug,info

# ─── 认证（R9）──────────────────────────────────────────
# 【没有下面任意一项，cortexd 会拒绝启动。】这不是为了烦人：一个不认证的
# cortexd 会把整个记忆库交给任何能连上这个端口的人，而这件事没有任何症状 ——
# 直到有人发现你的对话历史在公网上。当场失败比静默敞开好。
#
# 生成一份凭据（服务端拿摘要，客户端拿明文，一条命令同时给出两者）：
#     cargo run -p cortexd -- --generate-token
#
# 服务端只存摘要 —— 这个文件被读走也拿不到能用来登录的东西。
# CORTEX_AUTH_TOKEN_SHA256=
#
# 客户端（CLI / Flutter）用明文。**生产环境不该把它和摘要放在同一台机器上**；
# 开发机图方便可以都写在这里。
# CORTEXD_TOKEN=
#
# 逃生口：只听回环的开发机确实不想要认证时，显式写下面这一行。
# 取值刻意不是 1 / true —— 它只能是读懂了才会写下的东西。
# 开着它的时候 /health 会一直报 auth: disabled，启动日志里也有一行警告。
# CORTEX_AUTH=disabled

# ─── 工具确认回路（R11）─────────────────────────────────
# 高风险工具（写文件、执行命令）会通过 SSE 向客户端要一次确认，然后挂起等回执。
# 这么多秒还没人回答就**按拒绝处理**继续那一轮 —— 没人回答意味着没人看见，
# 而「关掉笔记本盖子等于把 shell 交出去」是不可挽回的错误方向。
# 缺省 180 秒。集成测试把它调到几秒。
# CORTEX_CONFIRM_TIMEOUT_SECS=180
#
# 注意 OS 沙箱是**独立的一层**：批准了也仍然要过 CORTEX_SANDBOX 那一关。
# Linux / macOS 之外没有对等的沙箱，命令执行默认被拒（见 cortex-agent/src/sandbox）。

# ─── LLM 供应商（按需填写，不要提交真实密钥）──────────────
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=

# ─── 备份与灾备 ─────────────────────────────────────────
# 全都有默认值，开发机不用改。细节见 docs/operations.md。
# 【生产必改】备份根要指到与数据盘不同的物理盘 —— 和数据同盘的备份
# 防得住误删，防不住盘坏，而盘坏才是备份存在的理由。
CORTEX_BACKUP_DIR=./data/backup
# 第二存储。不配就只镜像到本机目录 CORTEX_MIRROR_DIR ——
# 那同样防不住整机丢失，脚本每次跑都会明说这一点。
CORTEX_MIRROR_DIR=./data/mirror
# CORTEX_MIRROR_S3_ENDPOINT=
# CORTEX_MIRROR_S3_ACCESS_KEY=
# CORTEX_MIRROR_S3_SECRET_KEY=
# CORTEX_MIRROR_S3_BUCKET=

# Postgres 数据卷名，just pg-enable-checksums 要用它离线挂载
PG_VOLUME=cortex_pg_data
# 想钉版本就改这里，默认跟 latest
RCLONE_IMAGE=rclone/rclone:latest

# ─── 备份告警（R7）──────────────────────────────────────
# 【一个都不配的话，备份失败与备份从没跑过在现象上完全一样：什么都没发生。】
# 配完立刻自测：just notify-test
#
# 通用 webhook。格式开关能对上企业微信 / 钉钉 / Slack / Discord 的入站机器人。
# CORTEX_ALERT_WEBHOOK_URL=
# raw（默认，结构化 JSON）| slack | discord | wecom | dingtalk
# CORTEX_ALERT_WEBHOOK_FORMAT=raw
# 钉钉/企业微信机器人若配了「关键词」安全策略，不含关键词的消息会被静默丢弃
# （而且对端返回 200）。把关键词填这里，脚本会前置进正文。
# CORTEX_ALERT_KEYWORD=
# 最低发送级别：ok | warn | fail。默认 warn —— 天天响的告警两周内就会被静音。
# CORTEX_ALERT_MIN_LEVEL=warn
# 逃生口：任意命令。正文从 stdin 进，元信息在 CORTEX_ALERT_* 环境变量里。
# 刻意不内建 SMTP（见 scripts/notify.sh 头部的理由），要邮件就接你已经在用的工具：
# CORTEX_ALERT_CMD=mail -s "$CORTEX_ALERT_TITLE" ops@example.com
#
# 【心跳 / 死人开关】——「压根没跑」不会产生任何退出码，只有它能发现。
# healthchecks.io 风格：成功打 <URL>、失败打 <URL>/fail、开始打 <URL>/start
# CORTEX_HEARTBEAT_URL=
# path（默认，healthchecks.io）| query（Uptime Kuma 的 push 监控）
# CORTEX_HEARTBEAT_STYLE=path
#
# 本机看门狗（scripts/backup-watchdog.sh，建议 cron 每小时跑）的阈值
# CORTEX_BACKUP_MAX_AGE_H=30
# CORTEX_DRILL_MAX_AGE_D=40
# 通知里显示的主机名，多机时用来区分
# CORTEX_ALERT_HOST=

# ─── 备份加密（R6）──────────────────────────────────────
# 【密钥丢了备份就等于没有。】设了口令，推到第二存储的东西就自动加密
# （rclone crypt），本机那份仍是明文的 plain 备份 —— 这样 pg_verifybackup
# 与 rclone 增量都不受影响。细节见 docs/operations.md。
#
# 生成一对：  just backup-key gen
# 生成之后**必须**离开这台机器存一份：just backup-key card
#   机器整机丢了 → .env 没了 → 异地那份加密备份变成一堆随机字节。
# 验证能解开：just backup-key check   （真往返，不是"看起来对"）
# CORTEX_BACKUP_ENC_PASSPHRASE=
# CORTEX_BACKUP_ENC_SALT=
# 轮转世代。换密钥 = 世代加一后重新写，旧世代留到旧备份过期。
# 它在未加密的路径层，所以不拿钥匙也能看出有几代。见 just backup-key rotate-plan
# CORTEX_BACKUP_ENC_EPOCH=1

# ─── ⚠️ 下面这一节**这一侧一个都不读**（归 Cormex）─────────
#
# 2026-08-17 逐个查过：在 crates/ scripts/ compose/ justfile/ app/lib 里
# 一处引用都没有。它们是拆分前留下的，今天属于记忆服务
# （github.com/weironz/cormex）—— 对象存储、向量化、转录都在那边。
#
# **没删**，理由是部署常把两者放在同一台机器、共用一份 .env：删掉的话，
# 在这台机器上配 Cormex 的人会以为这些变量不存在。但照着它们在**本仓库**
# 配任何东西都不会有效果。
#
# 全部十三个：CORTEXD_PUBLIC_BIND / RUSTFS_DISK0..3 / CORTEX_BACKEND /
#   CORTEX_EMBED_BATCH / CORTEX_EMBED_LEGACY_{ENDPOINT,MODEL,API_KEY} /
#   CORTEX_REEMBED_BATCH / CORTEX_REEMBED_INTERVAL_SECS / CORTEX_VISION_BASE_URL
#
# 顺带一条与它们相关的事实：**这一侧生产不发布任何端口**，只经 traefik
# 出去（deploy/docker-compose.yml 里连 ports: 都没有），所以
# CORTEXD_PUBLIC_BIND 这类「对外绑定」在这边没有对应物。

# ─── 生产部署（docker-compose.prod.yml 才读）─────────────
# 对外绑定。默认只听回环；要对公网提供服务请放在反代之后。
# CORTEXD_PUBLIC_BIND=127.0.0.1:8080
# 四卷纠删码的四块盘。必须是四个**独立块设备**，
# 挂同一块盘是假冗余，RustFS 会拒绝启动 —— 那是正确行为。
#   lsblk -o NAME,MOUNTPOINT,PKNAME
# RUSTFS_DISK0=/mnt/disk0
# RUSTFS_DISK1=/mnt/disk1
# RUSTFS_DISK2=/mnt/disk2
# RUSTFS_DISK3=/mnt/disk3

# ─── 媒体转录（可选）────────────────────────────────────
# 不设则整条关闭：图片照常归档，只是检索不到。
# 刻意不给默认值——配个假的转录器会往库里写垃圾 caption，而垃圾比空白更难发现。
# DeepSeek 目前没有 vision 能力，本机 ollama 是最省事的选择。
# CORTEX_VISION_PROVIDER=ollama
# CORTEX_VISION_MODEL=gemma4:latest

# ─── 向量化（embedding）─────────────────────────────────
#
# 这是**记忆检索**用的，不是对话模型。对话走 CORTEX_LLM_* 那一组。
#
# 三种后端：
#   api （默认）  调远端 OpenAI 兼容的 /v1/embeddings
#   hash          确定性散列桩。**不是语义空间**，只用于离线开发与 CI，
#                 检索质量的评测结果在它上面没有意义
#   fast          进程内 ONNX 推理。需要用 feature `local-embed` 编的二进制 ——
#                 **官方镜像里没有**（它常驻 1 GiB，见 Dockerfile.cortexd 顶部），
#                 填了会在启动时被明确拒绝，不会静默降级
#
# ★ 模型必须是 **1024 维** —— schema 写死 VECTOR(1024)。
#   OpenAI 的 text-embedding-3-small 是 1536、large 是 3072，直接接会被
#   cortexd 在第一次响应就拒掉（错误信息里写了怎么办）。
CORTEX_EMBED_BACKEND=api

# ── 走法一（默认）：任何一家 OpenAI 兼容的云 ──
# 填基地址即可，/v1/embeddings 会自动补全。**key 必须自己填** ——
# 空着的话 cortexd 照常启动，只在第一次向量化时失败
CORTEX_EMBED_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
CORTEX_EMBED_MODEL=text-embedding-v4
CORTEX_EMBED_API_KEY=

# ── 走法二：本地自建 TEI（docker compose --profile embed up -d）──
#
# ⚠️ **地址取决于 cortexd 跑在哪，这是最容易配错的一处**：
#   `just run`（cortexd 在宿主进程）→ http://127.0.0.1:8090/v1/embeddings
#   `just dev` / 生产（cortexd 在容器）→ http://embeddings/v1/embeddings
# 在容器里填 127.0.0.1 指的是**容器自己的回环**，不是宿主 —— 症状是
# 「连接被拒绝」而地址看着完全正确。
#
# 它比这套栈里别的东西都重（bge-m3 权重 2.2 GB，常驻 2.5–3 GB），
# 开发机吃不消就走法一或三
# CORTEX_EMBED_ENDPOINT=http://embeddings/v1/embeddings
# CORTEX_EMBED_MODEL=bge-m3

# ── 走法三：离线开发 / 无网 CI ──
# CORTEX_EMBED_BACKEND=hash

# 单次请求最多几条。默认 10 —— 不是性能调优，是兼容性下限
# （TEI 默认允许 32，阿里百炼 text-embedding-v3 只到 10）
# CORTEX_EMBED_BATCH=10

# ─── 换 embedding 模型时的回填 ───────────────────────────
#
# 换模型之后旧事实的向量还在旧空间里，而向量查询按模型过滤 ——
# 它们会**当天退出向量召回**，而 BM25 / 图遍历 / 近因三路照常，
# 所以界面上只表现为「语义召回好像变差了点」，不会报错。
# 回填器把它们补回来。`/health` 的 embedding.stale 是进度条。
#
# 默认**开**。关掉的代价（旧记忆永久进不了向量召回）没有任何症状，
# 开着的代价（一次全库 embedding 调用，走云是要花钱的）是可见的，
# 而且它会在启动日志里先把条数报出来再动手。
# CORTEX_REEMBED=off
# CORTEX_REEMBED_BATCH=64            # 每轮补多少条
# CORTEX_REEMBED_INTERVAL_SECS=300   # 两轮之间隔多久

# ── 回填期间也别丢记忆：把查询同时编到**旧空间** ──
#
# 设了之后每次检索会在新旧两个空间各捞一遍，按名次交替合并。
# 只在回填没跑完之前有意义，补完就该删掉这三行（省掉每次检索一次额外调用）。
#
# ⚠️ 它救不了「0.1.1 的进程内 fastembed → 0.1.2 的远端 API」那一次迁移：
#    旧模型是 fastembed，而它默认已经不编进二进制了。那一次只能靠回填器
#    把窗口熬过去，期间 BM25 / 图 / 近因三路兜着。
#    这几个变量覆盖的是**将来的 api→api 换模型**（换云厂商 / 换模型名）。
# CORTEX_EMBED_LEGACY_ENDPOINT=https://old-vendor.example.com/v1
# CORTEX_EMBED_LEGACY_MODEL=old-model-name
# CORTEX_EMBED_LEGACY_API_KEY=sk-...

# ── 账号 ───────────────────────────────────────────────────
#
# 开放注册。**只认 `enabled` 这一个字面量** —— 设成 1 / true / yes
# 都算关着，理由与 CORTEX_AUTH=disabled 相同：一个手滑的取值不该把门打开。
#
# 关着时仍有两条建号的路：
#   1. **第一个账号永远放行**（私有化部署的第一分钟不该需要 shell）
#   2. cortexd --create-user <用户名>，密码从 stdin 读
#
# ⚠️ 开之前先想清楚：配额（roadmap R9 的「配额与自带 key」）还没做，
# 所以现在开放注册 = 任何注册的人都在花服务端那把 LLM key 的钱。
CORTEX_OPEN_REGISTRATION=enabled

# 每人每 30 天（滚动窗口）的 token 上限。**设成 0 表示不限**。
#
# 默认 200 万 ≈ 每人每月两元（按廉价模型每百万一元估）。够日常对话用很久，
# 而一次三年历史导入（实测 408 万 token）会撞上它 —— 那正是希望它撞上的：
# 导入该先跟主人打个招呼。
#
# 自托管单人用时设 0 —— 花的是自己的钱，配额只会碍事。
CORTEX_QUOTA_TOKENS_PER_MONTH=2000000

# 模型价目 —— 设置里那一页拿它把 token 换算成钱。
#
# 形如 `模型=输入/输出`，价格以**元 / 百万 token** 计，逗号分隔。
# 不设的话用内置那张表（只有 DeepSeek 那两个 —— 见 crates/cortex-agentd/src/pricing.rs：
# 写一张「主流模型全都有」的表等于给一堆没验证过的数字盖章）。
#
# ⚠️ 这个变量**整张覆盖**内置表，不是合并。要的就是「这个部署只有这几个模型」
#    说得出口。
#
# ⚠️ 没有价目的模型不按 0 算，它们在界面上显示「没有价目」——
#    「用了 300 万 token，花了 ¥0.00」读起来是免费，而事实是我们不知道。
#    本机跑的模型真的不要钱，那就明写 `=0/0`，那与「不知道」是两回事。
#
# CORTEX_MODEL_PRICES=deepseek-v4-pro=2/8,deepseek-v4-flash=0.5/2,local-qwen3-32b=0/0

# 货币代码。只影响显示，不参与计算。默认 CNY。
# CORTEX_PRICE_CURRENCY=CNY

# 美元 → 显示货币的汇率。**不配就整个用美元显示。**
#
# 模型目录（5184 个模型，编译期嵌在二进制里）的价目一律是美元 / 百万 token。
# 想显示人民币就配这一行；不配的话用量页会老实显示美元，而不是按某个
# 随手挑的汇率折一个数出来 —— 那种金额用户没法判断对不对，也不知道该按
# 哪天的汇率复核。配了之后界面上会写明「按 X 折算」。
# CORTEX_USD_RATE=7.10

# ── 供应商 ──────────────────────────────────────────────────
#
# 这个部署连哪一家（CORTEX_LLM_PROVIDER）决定了模型选择器里能选什么。
# 内置九家：anthropic(claude) / openai(chatgpt) / google(gemini) /
# xai(grok) / deepseek / zhipu(glm) / minimax / alibaba(qwen) /
# moonshot(kimi)，外加 goose 目录里那三十多家。
#
# ⚠️ 加一家通常**只要加一个 JSON**（crates/cortex-llm/src/definitions/）——
# 只要那家讲 openai / anthropic / ollama 里的一种协议。Gemini 是例外：
# 它讲第四种协议，走 cortex-providers 里的专用实现。

# 自带 API key 的主密钥（32 字节 hex，`openssl rand -hex 32` 生成）。
#
# 用户在设置里填的 API key 用它加密之后才落库，而它**不进数据库** ——
# 于是一份被拖走的备份里没有可用的 key，这是加密存储的全部意义。
#
# 没配的话「自己的 API key」那个入口会如实显示「这个部署没有开启」，
# 而不是明文存下去。**换掉它会让所有已存的 key 解不开**（界面上会说清楚
# 让用户重新填一次），所以生成一次就别再动。
CORTEX_SECRET_KEY=

# 把请求打到别的地方 —— OpenAI 兼容的任意端点。
#
# 供应商定义（含 base_url）是编译进二进制的。没有这一项，想指向自建的
# vLLM / llama.cpp / LM Studio、公司内网网关、one-api / LiteLLM 这类中转、
# 或者某个更便宜的兼容服务，都只能改代码重编。
#
# 「OpenAI 兼容」几乎是事实标准，所以一个 URL 覆盖比把供应商逐个加进内置
# 清单可用得多 —— 也免得「支持哪些供应商」变成我们要维护的一张表。
#
# 模型名用 CORTEX_LLM_MODEL 配（未知模型名不会被拒，退回默认上下文上限）。
# 例：CORTEX_LLM_PROVIDER=openai + CORTEX_LLM_BASE_URL=http://127.0.0.1:8000/v1
#     + CORTEX_LLM_MODEL=qwen3-32b
CORTEX_LLM_BASE_URL=

# 转录（vision）走另一个端点。留空 = 与上面同一个供应商定义里的默认值。
# 「对话走本地、看图走云上」是自建部署里常见的混合形态
CORTEX_VISION_BASE_URL=

# 第一个管理员账号。**在服务开始监听之前建好**，于是不需要「第一个访问
# /auth/register 的人成为主人」那条特例 —— 公网上那个抢主人窗口不存在。
#
# 行为（两个都空 = 绝大多数部署，什么都不做）：
#   两个都填，账号不存在  → 建号
#   两个都填，账号已存在  → 跳过。**不改密码**
#   只填了一个            → **拒绝启动**
#
# 「只填一个就拒绝启动」不是吹毛求疵：半份配置建不出账号，而它没有任何
# 症状 —— 服务照起、healthy 照报，只是谁也登不进去，而你以为配了管理员。
#
# 「已存在时不改密码」同理：否则忘了从 .env 删掉这两行的人，每次重启都会
# 把用户在界面上改过的密码重置回这里写的那个，而他不会想到去看环境变量。
# 真要改密码那是另一件事（需要旧密码）。
#
# 建完之后可以把 PASSWORD 这行删掉。不想把口令写进文件的话用另一条路：
#   printf '%s' '<口令>' | cortex-agentd --create-user <用户名>
# 两条落到同一个函数（accounts::create_account_in），不是两份实现。
CORTEX_ADMIN_USERNAME=
CORTEX_ADMIN_PASSWORD=
