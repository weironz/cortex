        <mxCell id="e3" value="/llm/stream · /episodes · /memory/search&#xa;其余路径原样反代" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;fontSize=11;" edge="1" parent="1" source="local" target="cormex">
