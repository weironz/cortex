          <mxGeometry x="285" y="45" width="120" height="55" as="geometry" />
        </mxCell>

        <mxCell id="lagent" value="★ 本地 agent 进程（要新建）&#xa;&lt;font style=&quot;font-size:11px;&quot; color=&quot;#7a5200&quot;&gt;= 现在的 cortexd 去掉数据库&lt;/font&gt;" style="swimlane;html=1;startSize=44;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=3;fontSize=13;fontStyle=1;fontColor=#7a5200;verticalAlign=middle;align=center;" vertex="1" parent="desk">
          <mxGeometry x="20" y="120" width="560" height="200" as="geometry" />
        </mxCell>
        <mxCell id="loop" value="agent 循环" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="lagent">
          <mxGeometry x="15" y="55" width="165" height="50" as="geometry" />
        </mxCell>
        <mxCell id="tools" value="工具执行&#xa;&lt;font style=&quot;font-size:10px;&quot;&gt;read/write/list/shell&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="lagent">
          <mxGeometry x="195" y="55" width="175" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sbx" value="OS 沙箱&#xa;&lt;font style=&quot;font-size:10px;&quot;&gt;landlock / seatbelt&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="lagent">
          <mxGeometry x="385" y="55" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="lanote" value="LLM 调用、工具执行、注入编排都在这里。&#xa;它不含数据库、不含记忆引擎 —— 记忆一律问远端。" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#7a5200;" vertex="1" parent="lagent">
          <mxGeometry x="15" y="120" width="530" height="60" as="geometry" />
        </mxCell>

        <mxCell id="fs" value="本机文件系统&#xa;&lt;font style=&quot;font-size:11px;&quot; color=&quot;#7f7f7f&quot;&gt;你的代码 / 文档&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="L1">
          <mxGeometry x="650" y="215" width="230" height="130" as="geometry" />
        </mxCell>

        <mxCell id="cli" value="CLI（cortex）&#xa;&lt;font style=&quot;font-size:11px;&quot; color=&quot;#7f7f7f&quot;&gt;已有 · 能渲染工具事件、答确认&#xa;★ D 之后直连 127.0.0.1 的本地 agent&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="L1">
          <mxGeometry x="920" y="65" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="web" value="Web（Flutter Web）&#xa;&lt;font style=&quot;font-size:11px;&quot; color=&quot;#7f7f7f&quot;&gt;已有 · 浏览器&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=8;" vertex="1" parent="L1">
          <mxGeometry x="920" y="240" width="250" height="160" as="geometry" />
        </mxCell>
        <mxCell id="webnote" value="附件上传下载 / 图片理解 /&#xa;代码高亮都有&#xa;&#xa;&lt;font color=&quot;#b85450&quot;&gt;没有在线桌面时，&lt;b&gt;不能操作&#xa;你机器上的文件&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#2d5016;" vertex="1" parent="web">
          <mxGeometry x="10" y="58" width="230" height="95" as="geometry" />
        </mxCell>

        <mxCell id="L2" value="② cortexd — 记忆服务" style="swimlane;html=1;startSize=34;fillColor=none;strokeColor=#9673a6;fontSize=15;fontStyle=1;fontColor=#6a4c93;verticalAlign=middle;align=left;spacingLeft=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="670" width="1200" height="300" as="geometry" />
        </mxCell>
        <mxCell id="deploynote" value="★ 它在哪是&lt;b&gt;部署选择&lt;/b&gt;，不是架构选择：localhost（单机，今天就能跑） / 局域网 / 云（多设备才需要）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#6a4c93;" vertex="1" parent="L2">
          <mxGeometry x="330" y="4" width="860" height="26" as="geometry" />
        </mxCell>
        <mxCell id="ep_old" value="已有端点" style="swimlane;html=1;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;" vertex="1" parent="L2">
          <mxGeometry x="20" y="60" width="330" height="200" as="geometry" />
        </mxCell>
        <mxCell id="ep_old_t" value="/chat&#xa;/memory/search&#xa;/sessions　/sync　/ws&#xa;/blobs　/confirmations" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontFamily=Courier New;spacingLeft=16;" vertex="1" parent="ep_old">
          <mxGeometry x="10" y="35" width="310" height="155" as="geometry" />
        </mxCell>

        <mxCell id="ep_new" value="★ 要新建的端点" style="swimlane;html=1;startSize=30;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=3;fontSize=12;fontStyle=1;fontColor=#7a5200;" vertex="1" parent="L2">
          <mxGeometry x="380" y="60" width="400" height="200" as="geometry" />
        </mxCell>
        <mxCell id="ep_new_t" value="GET  /memory/context&#xa;&lt;font style=&quot;font-size:10px;&quot; color=&quot;#7a5200&quot;&gt;　　　检索 + 渲染成注入块&lt;/font&gt;&#xa;POST /episodes&#xa;&lt;font style=&quot;font-size:10px;&quot; color=&quot;#7a5200&quot;&gt;　　　写回对话、触发抽取&lt;/font&gt;&#xa;POST /llm/stream　&lt;font color=&quot;#b85450&quot;&gt;（可选）&lt;/font&gt;&#xa;&lt;font style=&quot;font-size:10px;&quot; color=&quot;#7a5200&quot;&gt;　　　代理 LLM；不用它就本地直连&lt;/font&gt;&#xa;中继通道　&lt;font color=&quot;#b85450&quot;&gt;（remote control 用）&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontFamily=Courier New;spacingLeft=14;" vertex="1" parent="ep_new">
          <mxGeometry x="10" y="33" width="380" height="160" as="geometry" />
        </mxCell>

        <mxCell id="engine" value="内部组件" style="swimlane;html=1;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="L2">
          <mxGeometry x="810" y="60" width="360" height="200" as="geometry" />
        </mxCell>
        <mxCell id="eng1" value="记忆引擎：四路召回 + RRF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;" vertex="1" parent="engine">
          <mxGeometry x="15" y="42" width="330" height="38" as="geometry" />
        </mxCell>
        <mxCell id="eng2" value="抽取管线" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;" vertex="1" parent="engine">
          <mxGeometry x="15" y="90" width="160" height="38" as="geometry" />
        </mxCell>
        <mxCell id="eng3" value="embedding 回填器" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;" vertex="1" parent="engine">
          <mxGeometry x="185" y="90" width="160" height="38" as="geometry" />
        </mxCell>
        <mxCell id="eng4" value="注入编排：稳定块进可缓存前缀" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;" vertex="1" parent="engine">
          <mxGeometry x="15" y="138" width="330" height="38" as="geometry" />
        </mxCell>

        <mxCell id="L3" value="③ 数据与外部依赖" style="swimlane;html=1;startSize=34;fillColor=none;strokeColor=#9673a6;fontSize=15;fontStyle=1;fontColor=#6a4c93;verticalAlign=middle;align=left;spacingLeft=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="1050" width="1200" height="190" as="geometry" />
        </mxCell>
        <mxCell id="pg" value="Postgres 17 + pgvector&#xa;&lt;font style=&quot;font-size:10px;&quot; color=&quot;#7f7f7f&quot;&gt;事实 / episodes / 向量 / sync_log&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=13;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="L3">
          <mxGeometry x="30" y="55" width="260" height="115" as="geometry" />
        </mxCell>
        <mxCell id="rustfs" value="RustFS&#xa;&lt;font style=&quot;font-size:10px;&quot; color=&quot;#7f7f7f&quot;&gt;S3 兼容对象存储 · 媒体&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=13;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="L3">
          <mxGeometry x="320" y="55" width="260" height="115" as="geometry" />
        </mxCell>
        <mxCell id="emb" value="embeddings 服务&#xa;&lt;font style=&quot;font-size:10px;&quot; color=&quot;#7f7f7f&quot;&gt;TEI，OpenAI 兼容 /v1/embeddings&#xa;或指向云（百炼 / Jina …）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="L3">
          <mxGeometry x="610" y="60" width="260" height="105" as="geometry" />
        </mxCell>
        <mxCell id="llm" value="LLM 供应商&#xa;&lt;font style=&quot;font-size:10px;&quot; color=&quot;#7f7f7f&quot;&gt;DeepSeek API&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="L3">
          <mxGeometry x="900" y="60" width="260" height="105" as="geometry" />
        </mxCell>

        <mxCell id="note_bad" value="❌ 被否掉的方案：循环在服务端、工具外派到本地" style="swimlane;html=1;startSize=34;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;fontColor=#7d2f2c;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1330" y="110" width="440" height="190" as="geometry" />
        </mxCell>
        <mxCell id="note_bad_t" value="· 一轮 20 次文件操作 = 20 个跨国往返，&#xa;　而本地是微秒级&#xa;&#xa;· 服务端从此能让你的机器跑 shell ——&#xa;　服务器被攻破 = 所有连着的桌面被攻破&#xa;&#xa;· 要新造一套工具外派协议" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#7d2f2c;spacingLeft=8;" vertex="1" parent="note_bad">
          <mxGeometry x="10" y="40" width="420" height="145" as="geometry" />
        </mxCell>

        <mxCell id="note_good" value="✅ 选中的方案" style="swimlane;html=1;startSize=34;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;fontColor=#2d5016;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1330" y="330" width="440" height="190" as="geometry" />
        </mxCell>
        <mxCell id="note_good_t" value="服务端只提供记忆，&#xa;&lt;b&gt;没有任何能力让你的机器做事&lt;/b&gt;。&#xa;&#xa;· 工具在本地跑，文件「就是能读到」&#xa;· 新概念数量为零 —— 本地那个进程就是&#xa;　现在的 cortexd，换个拿记忆的方式&#xa;· 同时留下了「记忆层可插拔」这个选项" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#2d5016;spacingLeft=8;" vertex="1" parent="note_good">
          <mxGeometry x="10" y="40" width="420" height="145" as="geometry" />
        </mxCell>

        <mxCell id="note_deg" value="⚠️ 连不上 cortexd 时：能干活，没记忆" style="swimlane;html=1;startSize=34;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;fontColor=#7a5200;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1330" y="550" width="440" height="215" as="geometry" />
        </mxCell>
        <mxCell id="note_deg_t" value="&lt;b&gt;不是「打不开」，是「变成 Claude Code」&lt;/b&gt;：&#xa;循环、工具、shell、LLM 照常，&#xa;失去的恰好只有记忆 —— 界面上明说。&#xa;&#xa;· 写入不丢：对话进本地 append-only 队列，&#xa;　联网后灌给 cortexd 抽取 + 索引&#xa;· &lt;b&gt;不在本地存第二份记忆库&lt;/b&gt; —— 那要把整个&#xa;　检索引擎写第二遍（pgvector / tsvector /&#xa;　advisory lock 都没有对应物），而且更弱" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#7a5200;spacingLeft=8;" vertex="1" parent="note_deg">
          <mxGeometry x="10" y="38" width="420" height="172" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="图例" style="swimlane;html=1;startSize=30;fillColor=none;strokeColor=#999999;fontSize=12;fontStyle=1;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1330" y="800" width="440" height="130" as="geometry" />
        </mxCell>
        <mxCell id="lg1" value="" style="rounded=1;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=3;" vertex="1" parent="legend">
          <mxGeometry x="15" y="42" width="36" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg1t" value="★ 要新建的（本次架构决定的产物）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="legend">
          <mxGeometry x="60" y="40" width="360" height="24" as="geometry" />
        </mxCell>
        <mxCell id="lg2" value="" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="legend">
          <mxGeometry x="15" y="76" width="36" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lg2t" value="已有的（今天就在跑）" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="legend">
          <mxGeometry x="60" y="74" width="360" height="24" as="geometry" />
        </mxCell>

        <mxCell id="e_fs" value="工具在这里执行，微秒级" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#d79b00;fontSize=12;fontColor=#7a5200;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=classic;startFill=1;" edge="1" parent="1" source="lagent" target="fs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_mem" value="记忆检索 · 写回&#xa;（这是唯一必需的远程依赖）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=4;strokeColor=#d79b00;fontSize=13;fontStyle=1;fontColor=#7a5200;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;startArrow=classic;startFill=1;" edge="1" parent="1" source="desk" target="L2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_llm_direct" value="★ 或本地直连（key 在本地）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeWidth=2;strokeColor=#d6b656;fontSize=12;fontColor=#7a5200;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="lagent" target="llm">
          <mxGeometry x="-0.72" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="26" y="400" />
              <mxPoint x="26" y="1280" />
              <mxPoint x="1090" y="1280" />
            </Array>
            <mxPoint x="90" y="0" as="offset" />
          </mxGeometry>
        </mxCell>

        <mxCell id="e_remote" value="★ remote control&#xa;（经 cortexd 中继，挂到在线的本地 agent）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeWidth=3;strokeColor=#9673a6;fontSize=12;fontStyle=1;fontColor=#6a4c93;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.18;entryDx=0;entryDy=0;endArrow=classic;endFill=1;" edge="1" parent="1" source="cli" target="desk">
          <mxGeometry relative="1" as="geometry" />
