        </mxCell>
        <mxCell id="subtitle" value="agent 循环跟着「文件」走（本地）　·　记忆权威跟着「持久与多端」走（远端）" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="62" width="900" height="24" as="geometry" />
        </mxCell>

        <mxCell id="L1" value="① 客户端层" style="swimlane;html=1;startSize=34;fillColor=none;strokeColor=#9673a6;fontSize=15;fontStyle=1;fontColor=#6a4c93;verticalAlign=middle;align=left;spacingLeft=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="1200" height="420" as="geometry" />
        </mxCell>

        <mxCell id="desk" value="桌面端（Windows 安装程序）" style="swimlane;html=1;startSize=32;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="L1">
