<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="31.1.5">
  <diagram name="Cortex 架构">
    <mxGraphModel dx="1800" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Cortex 架构（实况）" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="600" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="agent 循环跟着「文件」走，记忆权威跟着「持久与多端」走。两者之间只有 HTTP。" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="900" height="20" as="geometry" />
        </mxCell>

        <mxCell id="laneA" value="你的机器" style="swimlane;startSize=30;html=1;fillColor=none;strokeColor=#666666;dashed=1;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="620" height="440" as="geometry" />
        </mxCell>
        <mxCell id="gui" value="Flutter 桌面端" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="laneA">
          <mxGeometry x="30" y="60" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cli" value="cortex CLI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="laneA">
          <mxGeometry x="30" y="150" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="web" value="浏览器" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="laneA">
          <mxGeometry x="330" y="60" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="local" value="&lt;b&gt;cortex-local&lt;/b&gt;&#xa;agent 循环 · 文件/shell 工具 · OS 沙箱（landlock / seatbelt）&#xa;工具确认回路 · 断网 outbox&#xa;&lt;i&gt;没有数据库，也没有记忆引擎&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="laneA">
          <mxGeometry x="30" y="270" width="550" height="130" as="geometry" />
        </mxCell>

        <mxCell id="third" value="第三方 agent&#xa;Claude Code / goose" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="280" height="90" as="geometry" />
        </mxCell>

        <mxCell id="laneB" value="云端节点（同一台机器上跑着两个产品）" style="swimlane;startSize=30;html=1;fillColor=none;strokeColor=#666666;dashed=1;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="780" y="80" width="900" height="1060" as="geometry" />
        </mxCell>
        <mxCell id="edge0" value="&lt;b&gt;traefik（边缘）&lt;/b&gt;&#xa;分流在这里，&lt;b&gt;不在任何一个服务里&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="laneB">
          <mxGeometry x="60" y="60" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="agentd" value="&lt;b&gt;cortex-agentd&lt;/b&gt;&#xa;按需拉起沙箱容器 · 逐字节反代 · 闲了回收&#xa;&lt;i&gt;唯一碰 docker 的进程&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=12;" vertex="1" parent="laneB">
          <mxGeometry x="60" y="200" width="340" height="110" as="geometry" />
        </mxCell>
        <mxCell id="box" value="沙箱容器&#xa;&lt;b&gt;cortex-local --exec-env=container&lt;/b&gt;&#xa;&lt;i&gt;与你机器上那个是同一个二进制&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;align=left;spacingLeft=12;" vertex="1" parent="laneB">
          <mxGeometry x="60" y="370" width="340" height="130" as="geometry" />
        </mxCell>
        <mxCell id="egress" value="&lt;b&gt;cortex-egress-proxy&lt;/b&gt;&#xa;沙箱网段是 internal，&lt;b&gt;这是唯一出网口&lt;/b&gt;&#xa;CONNECT allowlist" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=12;" vertex="1" parent="laneB">
          <mxGeometry x="470" y="370" width="330" height="130" as="geometry" />
        </mxCell>
        <mxCell id="cormex" value="&lt;b&gt;Cormex · 记忆服务&lt;/b&gt;&#xa;（二进制仍叫 cortexd）&#xa;&#xa;HTTP / SSE / WS ／ &lt;b&gt;MCP 门面&lt;/b&gt;　·　抽取 · 四路召回 + RRF · 双时间轴回放&#xa;委托凭据签发（POST /delegated-tokens）&#xa;&lt;i&gt;不跑对话，也不碰 docker&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="laneB">
          <mxGeometry x="60" y="570" width="740" height="160" as="geometry" />
        </mxCell>
        <mxCell id="pg" value="PostgreSQL + pgvector&#xa;按 schema 分租户" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;boundedLbl=1;backgroundOutline=1;size=12;" vertex="1" parent="laneB">
          <mxGeometry x="60" y="800" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="rustfs" value="RustFS（S3 兼容）&#xa;附件与快照" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;boundedLbl=1;backgroundOutline=1;size=12;" vertex="1" parent="laneB">
          <mxGeometry x="460" y="800" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="repoNote" value="绿色那一块（Cormex）是&lt;b&gt;另一个仓库、另一条版本线&lt;/b&gt;：github.com/weironz/cormex&#xa;它出现在这里只是因为部署把两者放在同一台机器上 —— 代码上没有任何相互依赖。" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#666666;" vertex="1" parent="laneB">
          <mxGeometry x="60" y="930" width="740" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="laneA" source="gui" target="local">
